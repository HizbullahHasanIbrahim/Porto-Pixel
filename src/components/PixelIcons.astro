---
export interface Props {
  name?: 'pacman' | 'heart' | 'brain' | 'dna' | 'trophy' | 'claw' | 'terminal' | 'star' | 'coffee' | 'home' | 'github' | 'linkedin' | 'twitter';
  size?: number;
  color?: string;
  class?: string;
}

const {
  name = 'pacman',
  size = 16,
  color = 'currentColor',
  class: className = '',
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  shape-rendering="crispEdges"
  class={`pixel-icon pixel-icon-${name} ${className}`}
  aria-hidden="true"
>
  {name === 'pacman' && (
    <g fill={color}>
      <rect x="5" y="1" width="6" height="1" />
      <rect x="3" y="2" width="10" height="1" />
      <rect x="2" y="3" width="12" height="1" />
      <rect x="1" y="5" width="14" height="2" />
      <rect x="1" y="7" width="10" height="2" />
      <rect x="1" y="9" width="12" height="2" />
      <rect x="2" y="11" width="12" height="1" />
      <rect x="3" y="13" width="10" height="1" />
      <rect x="5" y="14" width="6" height="1" />
      <rect x="8" y="3" width="2" height="2" fill="#0b0d10" />
    </g>
  )}

  {name === 'heart' && (
    <g fill={color}>
      <rect x="2" y="3" width="4" height="4" />
      <rect x="10" y="3" width="4" height="4" />
      <rect x="4" y="2" width="3" height="1" />
      <rect x="9" y="2" width="3" height="1" />
      <rect x="1" y="5" width="14" height="4" />
      <rect x="2" y="9" width="12" height="2" />
      <rect x="4" y="11" width="8" height="2" />
      <rect x="6" y="13" width="4" height="2" />
      <rect x="7" y="15" width="2" height="1" />
      <rect x="3" y="4" width="2" height="2" fill="#ffffff" fill-opacity="0.8" />
    </g>
  )}

  {name === 'brain' && (
    <g fill={color}>
      <rect x="4" y="2" width="8" height="2" />
      <rect x="2" y="4" width="12" height="8" />
      <rect x="3" y="12" width="10" height="2" />
      <rect x="7" y="3" width="2" height="10" fill="#0b0d10" />
      <rect x="4" y="6" width="2" height="1" fill="#0b0d10" />
      <rect x="3" y="9" width="3" height="1" fill="#0b0d10" />
      <rect x="10" y="6" width="2" height="1" fill="#0b0d10" />
      <rect x="10" y="9" width="3" height="1" fill="#0b0d10" />
    </g>
  )}

  {name === 'dna' && (
    <g fill={color}>
      <rect x="2" y="1" width="3" height="2" />
      <rect x="11" y="1" width="3" height="2" />
      <rect x="5" y="2" width="6" height="1" />
      
      <rect x="4" y="4" width="3" height="2" />
      <rect x="9" y="4" width="3" height="2" />
      <rect x="6" y="5" width="4" height="1" />

      <rect x="7" y="7" width="2" height="2" />

      <rect x="4" y="10" width="3" height="2" />
      <rect x="9" y="10" width="3" height="2" />
      <rect x="6" y="10" width="4" height="1" />

      <rect x="2" y="13" width="3" height="2" />
      <rect x="11" y="13" width="3" height="2" />
      <rect x="5" y="13" width="6" height="1" />
    </g>
  )}

  {name === 'trophy' && (
    <g fill={color}>
      <rect x="4" y="2" width="8" height="6" />
      <rect x="2" y="3" width="2" height="4" />
      <rect x="12" y="3" width="2" height="4" />
      <rect x="5" y="8" width="6" height="2" />
      <rect x="7" y="10" width="2" height="3" />
      <rect x="4" y="13" width="8" height="2" />
      <rect x="7" y="4" width="2" height="2" fill="#0b0d10" />
    </g>
  )}

  {name === 'claw' && (
    <g fill={color}>
      <rect x="7" y="1" width="2" height="4" />
      <rect x="4" y="5" width="8" height="2" />
      <rect x="3" y="7" width="3" height="6" />
      <rect x="10" y="7" width="3" height="6" />
      <rect x="5" y="12" width="2" height="2" />
      <rect x="9" y="12" width="2" height="2" />
    </g>
  )}

  {name === 'terminal' && (
    <g fill={color}>
      <rect x="2" y="2" width="12" height="12" />
      <rect x="4" y="4" width="8" height="8" fill="#0b0d10" />
      <rect x="5" y="6" width="3" height="1" />
      <rect x="6" y="7" width="2" height="1" />
      <rect x="5" y="8" width="3" height="1" />
      <rect x="8" y="9" width="3" height="1" />
    </g>
  )}

  {name === 'star' && (
    <g fill={color}>
      <rect x="7" y="2" width="2" height="2" />
      <rect x="5" y="4" width="6" height="2" />
      <rect x="1" y="6" width="14" height="2" />
      <rect x="3" y="8" width="10" height="2" />
      <rect x="5" y="10" width="6" height="2" />
      <rect x="3" y="12" width="3" height="2" />
      <rect x="10" y="12" width="3" height="2" />
    </g>
  )}

  {name === 'coffee' && (
    <g fill={color}>
      <rect x="3" y="4" width="8" height="9" />
      <rect x="11" y="5" width="3" height="5" />
      <rect x="12" y="6" width="1" height="3" fill="#0b0d10" />
      <rect x="2" y="13" width="10" height="2" />
      <rect x="4" y="1" width="2" height="2" />
      <rect x="7" y="1" width="2" height="2" />
    </g>
  )}

  {name === 'home' && (
    <g fill={color}>
      <rect x="7" y="2" width="2" height="2" />
      <rect x="6" y="4" width="4" height="2" />
      <rect x="4" y="6" width="8" height="2" />
      <rect x="2" y="8" width="12" height="2" />
      <rect x="3" y="10" width="10" height="4" />
      <rect x="7" y="11" width="2" height="3" fill="#0b0d10" />
    </g>
  )}

  {name === 'github' && (
    <g fill={color}>
      <rect x="6" y="2" width="4" height="2" />
      <rect x="4" y="4" width="8" height="8" />
      <rect x="3" y="6" width="1" height="4" />
      <rect x="12" y="6" width="1" height="4" />
      <rect x="6" y="12" width="1" height="2" />
      <rect x="9" y="12" width="1" height="2" />
      <rect x="6" y="6" width="1" height="2" fill="#0b0d10" />
      <rect x="9" y="6" width="1" height="2" fill="#0b0d10" />
    </g>
  )}

  {name === 'linkedin' && (
    <g fill={color}>
      <rect x="2" y="2" width="12" height="12" />
      <rect x="4" y="4" width="2" height="2" fill="#0b0d10" />
      <rect x="4" y="7" width="2" height="5" fill="#0b0d10" />
      <rect x="7" y="7" width="2" height="5" fill="#0b0d10" />
      <rect x="9" y="7" width="2" height="1" fill="#0b0d10" />
      <rect x="10" y="8" width="1" height="4" fill="#0b0d10" />
    </g>
  )}

  {name === 'twitter' && (
    <g fill={color}>
      <rect x="2" y="3" width="2" height="2" />
      <rect x="4" y="5" width="2" height="2" />
      <rect x="6" y="7" width="4" height="2" />
      <rect x="10" y="5" width="2" height="2" />
      <rect x="12" y="3" width="2" height="2" />
      <rect x="2" y="11" width="2" height="2" />
      <rect x="12" y="11" width="2" height="2" />
    </g>
  )}
</svg>

<style>
  .pixel-icon {
    display: inline-block;
    vertical-align: middle;
    image-rendering: pixelated;
    flex-shrink: 0;
  }
</style>
