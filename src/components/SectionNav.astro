---
export interface NavSection {
  id: string;
  label: string;
}

export interface Props {
  sections?: NavSection[];
}

const { sections = [
  { id: 'hero', label: 'HERO' },
  { id: 'about', label: 'ABOUT' },
  { id: 'pixels', label: 'PIXELS' },
  { id: 'ideas', label: 'IDEAS' },
  { id: 'brain-section', label: 'BRAIN' },
  { id: 'dna', label: 'DNA' },
  { id: 'emotion', label: 'EMOTION' },
  { id: 'beauty', label: 'BEAUTY' },
  { id: 'hands', label: 'HANDS' },
  { id: 'windows', label: 'WINDOWS' },
  { id: 'tetris', label: 'TETRIS' },
  { id: 'world', label: 'WORLD' },
] } = Astro.props;
---

<nav class="section-nav" aria-label="Section navigation">
  <ul class="nav-dots">
    {sections.map((section: NavSection) => (
      <li>
        <a href={`#${section.id}`} class="nav-dot" data-target={section.id} aria-label={section.label}>
          <span class="dot"></span>
          <span class="dot-label">{section.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  let frame: number | null = null;

  function updateActiveSection() {
    frame = null;
    const navDots = Array.from(document.querySelectorAll<HTMLElement>('.nav-dot'));
    if (!navDots.length) return;

    const marker = window.innerHeight / 2;
    const isDesktop = window.innerWidth > 768;
    const orderedIds = navDots.map((d) => d.dataset.target).filter(Boolean) as string[];

    let currentId: string | null = null;

    if (isDesktop) {
      const topContainers = Array.from(document.querySelectorAll<HTMLElement>('section[id], footer[id]'));
      const activeContainer = topContainers.find((section) => {
        const bounds = section.getBoundingClientRect();
        return bounds.top <= marker && bounds.bottom > marker;
      }) ?? topContainers.reduce<HTMLElement | null>((closest, section) => {
        if (!closest) return section;
        const distance = Math.abs(section.getBoundingClientRect().top - marker);
        return distance < Math.abs(closest.getBoundingClientRect().top - marker) ? section : closest;
      }, null);

      if (activeContainer?.id === 'pixels') {
        const phase = (window as any).__hzbStoryPhase || 'pixels';
        currentId = phase;
      } else {
        currentId = activeContainer?.id ?? null;
      }
    } else {
      const allTargets = orderedIds
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      const activeElement = allTargets.find((el) => {
        const bounds = el.getBoundingClientRect();
        return bounds.top <= marker && bounds.bottom > marker;
      }) ?? allTargets.reduce<HTMLElement | null>((closest, el) => {
        if (!closest) return el;
        const distance = Math.abs(el.getBoundingClientRect().top - marker);
        return distance < Math.abs(closest.getBoundingClientRect().top - marker) ? el : closest;
      }, null);

      currentId = activeElement?.id ?? null;
    }

    const currentIndex = currentId ? orderedIds.indexOf(currentId) : -1;

    navDots.forEach((dot, index) => {
      const targetId = dot.dataset.target;
      if (!targetId) return;

      const active = targetId === currentId;
      const visited = currentIndex >= 0 && index < currentIndex;

      dot.classList.toggle('active', active);
      dot.classList.toggle('visited', visited);
      dot.setAttribute('aria-current', active ? 'location' : 'false');
    });
  }

  function scheduleActiveUpdate() {
    if (frame === null) frame = requestAnimationFrame(updateActiveSection);
  }

  function initNav() {
    updateActiveSection();
    window.addEventListener('scroll', scheduleActiveUpdate, { passive: true });
    window.addEventListener('resize', scheduleActiveUpdate);
    window.addEventListener('hzb-phase-change', scheduleActiveUpdate);

    // Smart smooth scroll for dots
    document.querySelectorAll<HTMLAnchorElement>('.nav-dot').forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const targetId = dot.dataset.target;
        if (!targetId) return;

        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;

        e.preventDefault();

        const isDesktop = window.innerWidth > 768;
        const pixelsSection = document.getElementById('pixels');

        if (isDesktop && pixelsSection && (targetId === 'pixels' || targetId === 'ideas' || targetId === 'brain-section')) {
          const pixelsTrigger = (window as any).ScrollTrigger?.getById('pixels-story-pin');
          if (pixelsTrigger) {
            let progress = 0;
            if (targetId === 'ideas') progress = 0.45;
            else if (targetId === 'brain-section') progress = 0.80;
            const scrollPos = pixelsTrigger.start + (pixelsTrigger.end - pixelsTrigger.start) * progress;
            window.scrollTo({ top: scrollPos, behavior: 'smooth' });
            history.pushState(null, '', `#${targetId}`);
            return;
          }
        }

        const rect = targetEl.getBoundingClientRect();
        const scrollPos = window.scrollY + rect.top;
        window.scrollTo({ top: scrollPos, behavior: 'smooth' });
        history.pushState(null, '', `#${targetId}`);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav, { once: true });
  } else {
    initNav();
  }

  window.addEventListener('pagehide', () => {
    window.removeEventListener('scroll', scheduleActiveUpdate);
    window.removeEventListener('resize', scheduleActiveUpdate);
    window.removeEventListener('hzb-phase-change', scheduleActiveUpdate);
    if (frame !== null) cancelAnimationFrame(frame);
  }, { once: true });
</script>

<style>
  .section-nav {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-dots {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.35rem, 1.1vh, 0.7rem);
    align-items: flex-end;
    position: relative;
  }
  
  .nav-dot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-muted);
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.55rem;
    padding: 4px;
    transition: all 0.15s;
  }
  
  .dot {
    width: 10px;
    height: 10px;
    background: var(--text-muted);
    border: 2px solid var(--border-color);
    box-shadow: 2px 2px 0px var(--border-color);
    border-radius: 2px;
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.2s, box-shadow 0.2s;
    position: relative;
  }
  
  /* Pac-Man character for active dot */
  .dot::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-primary);
    clip-path: polygon(50% 50%, 100% 0%, 100% 100%);
    opacity: 0;
    transform: scale(0);
    transition: opacity 0.2s, transform 0.2s;
  }
  
  .nav-dot:hover .dot {
    background: var(--accent-primary);
    transform: scale(1.4);
  }
  
  .nav-dot.active .dot {
    background: var(--text-muted);
    transform: scale(1);
  }
  
  .nav-dot.active .dot::before {
    opacity: 1;
    transform: scale(1);
    animation: pacman-chomp 0.5s ease-in-out infinite;
  }
  
  @keyframes pacman-chomp {
    0%, 100% { clip-path: polygon(50% 50%, 100% 0%, 100% 100%); }
    50% { clip-path: polygon(50% 50%, 100% 20%, 100% 80%); }
  }
  
  .nav-dot.visited .dot {
    background: var(--text-muted);
    opacity: 0.4;
  }
  
  .nav-dot.visited .dot::before {
    display: none;
  }

  .dot-label {
    opacity: 0;
    transform: translateX(4px);
    transition: opacity 0.2s, transform 0.25s;
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    padding: 2px 6px;
    white-space: nowrap;
    pointer-events: none;
    font-size: 0.45rem;
  }
  
  .nav-dot:hover .dot-label,
  .nav-dot.active .dot-label {
    opacity: 1;
    transform: translateX(0);
  }
  
  @media (max-width: 768px) {
    .section-nav {
      right: 0.4rem;
    }
    .nav-dots {
      gap: 0.5rem;
    }
    .dot {
      width: 7px;
      height: 7px;
      box-shadow: 1px 1px 0px var(--border-color);
    }
    .dot-label {
      display: none; /* Hide labels on mobile to avoid covering screen content */
    }
  }
</style>
