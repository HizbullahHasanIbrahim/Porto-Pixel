---
import Header from '../components/Header.astro';
import ContactDialog from '../components/ContactDialog.astro';
import PixelPreloader from '../components/PixelPreloader.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HZB Portfolio - Hizbullah Hasan Ibrahim',
  description = 'Interactive Retro-Pixel Portfolio of Hizbullah Hasan Ibrahim (HZB) - Information Systems & Creative Developer',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" data-mode="developer">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Press+Start+2P&family=Silkscreen:wght@400;700&family=Syne:wght@600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <script is:inline>
    // Theme initialization blocking script (prevents FOUC)
    (function() {
      try {
        const savedMode = localStorage.getItem('hzb-theme-mode');
        if (savedMode === 'creative' || savedMode === 'developer') {
          document.documentElement.setAttribute('data-mode', savedMode);
        } else {
          document.documentElement.setAttribute('data-mode', 'developer');
        }
      } catch (e) {
        document.documentElement.setAttribute('data-mode', 'developer');
      }
    })();
  </script>
</head>
<body>
  <PixelPreloader />
  <Header />
  <slot />
  <ContactDialog />
  
  <!-- CRT Scanlines Overlay (retro TV effect) -->
  <div class="crt-scanlines" aria-hidden="true"></div>
  
  <script>
    // Initialize sparkle effect on all pages
    import { initSparkleEffect } from '../utils/sparkleEffect.ts';

    let disposeSparkle: (() => void) | undefined;
    const startSparkles = () => {
      disposeSparkle?.();
      disposeSparkle = initSparkleEffect();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startSparkles, { once: true });
    } else {
      startSparkles();
    }

    window.addEventListener('pagehide', () => disposeSparkle?.(), { once: true });
  </script>
</body>
</html>
