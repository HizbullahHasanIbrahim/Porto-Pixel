---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
---

<BaseLayout title="PIXEL RUNNER | HZB Portfolio">
  <main class="game-main">
    <section class="game-header">
      <div class="title-area">
        <h1 class="game-title">PIXEL RUNNER</h1>
        <p class="game-sub">ENDLESS 8-BIT RUNNER // SAVE_SCORE.EXE</p>
      </div>
      <div class="game-stats">
        <RetroWindow title="GAME STATUS" type="sys">
          <div id="game-state-ui" class="status-box">
            MODE: <span id="current-mode" class="highlight-mode">DEVELOPER</span><br>
            POWER: <span id="power-status" class="highlight-power">READY</span>
          </div>
        </RetroWindow>
      </div>
    </section>

    <div class="game-container">
      <div class="game-ui">
        <div class="ui-score">SCORE: <span id="score-val">00000</span></div>
        <div class="ui-highscore">HI-SCORE: <span id="hi-score-val">00000</span></div>
      </div>

      <div class="canvas-wrapper">
        <canvas id="game-canvas" width="800" height="240"></canvas>
      </div>

      <!-- On-Screen Arcade Touch Controls for Mobile Users -->
      <div class="arcade-touch-pad" id="arcade-touch-controls" aria-label="Arcade Controls">
        <div class="touch-cluster-left">
          <button id="touch-btn-mode" class="arcade-touch-btn secondary" type="button" aria-label="Toggle Mode">
            <span class="btn-top-label">[S]</span>
            <span class="btn-main-label">MODE</span>
          </button>
          <button id="touch-btn-power-dev" class="arcade-touch-btn dev" type="button" aria-label="Slow-Mo Power">
            <span class="btn-top-label">[D]</span>
            <span class="btn-main-label">SLOW-MO</span>
          </button>
          <button id="touch-btn-power-creative" class="arcade-touch-btn creative" type="button" aria-label="Dash Power">
            <span class="btn-top-label">[C]</span>
            <span class="btn-main-label">2X DASH</span>
          </button>
        </div>

        <div class="touch-cluster-right">
          <button id="touch-btn-jump" class="arcade-touch-btn jump-btn" type="button" aria-label="Jump / Action">
            <span class="btn-top-label">[SPACE]</span>
            <span class="btn-main-label">JUMP</span>
          </button>
        </div>
      </div>

      <div class="game-controls-info">
        <div class="control-item">
          <span class="key">SPACE / TAP</span>
          <span>JUMP / START</span>
        </div>
        <div class="control-item">
          <span class="key">S</span>
          <span>TOGGLE MODE</span>
        </div>
        <div class="control-item">
          <span class="key">D</span>
          <span>DEV SLOW-MO</span>
        </div>
        <div class="control-item">
          <span class="key">C</span>
          <span>CREATIVE 2X DASH</span>
        </div>
      </div>
    </div>

    <RetroWindow title="LOCAL LEADERBOARD (TOP 10)" type="sys" class="leaderboard-window">
      <div class="table-responsive">
        <table class="leaderboard-table">
          <thead>
            <tr>
              <th>RANK</th>
              <th>NAME</th>
              <th>SCORE</th>
              <th>MODE</th>
            </tr>
          </thead>
          <tbody id="leaderboard-body">
            <!-- Populated by JS -->
          </tbody>
        </table>
      </div>
    </RetroWindow>
  </main>

  <!-- Game Over Overlay -->
  <div id="game-over-overlay" class="game-over-overlay" style="display: none;">
    <div class="game-over-dialog">
      <h2 class="game-over-title">GAME OVER</h2>
      <p class="final-score">SCORE: <span id="final-score-val">0</span></p>
      <input type="text" id="player-name" class="name-input" maxlength="8" placeholder="ENTER NAME" />
      <button id="save-score-btn" class="save-btn" type="button">SAVE & RESTART</button>
      <button id="new-game-btn" class="new-game-btn" type="button">NEW GAME</button>
    </div>
  </div>
</BaseLayout>

<script>
  interface Obstacle {
    x: number;
    y: number;
    width: number;
    height: number;
    color: string;
  }

  interface LeaderboardEntry {
    name: string;
    score: number;
    mode: string;
  }

  function initGame() {
    const canvas = document.getElementById('game-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const scoreEl = document.getElementById('score-val');
    const hiScoreEl = document.getElementById('hi-score-val');
    const modeEl = document.getElementById('current-mode');
    const powerEl = document.getElementById('power-status');
    const gameOverOverlay = document.getElementById('game-over-overlay') as HTMLElement | null;
    const finalScoreEl = document.getElementById('final-score-val');
    const playerNameInput = document.getElementById('player-name') as HTMLInputElement | null;
    const saveBtn = document.getElementById('save-score-btn') as HTMLButtonElement | null;
    const newGameBtn = document.getElementById('new-game-btn') as HTMLButtonElement | null;

    // Game state
    let gameRunning = false;
    let score = 0;
    let hiScore = parseInt(localStorage.getItem('hzb-runner-hi') || '0', 10) || 0;
    let frame = 0;
    let gameSpeed = 5;
    let timeScale = 1;
    let mode = 'developer';
    let powerActive = false;
    let powerCooldown = 0;
    let powerDuration = 0;

    // Player config
    const player = {
      x: 80,
      y: 190,
      width: 16,
      height: 16,
      vy: 0,
      gravity: 0.6,
      jumpPower: -12,
      isJumping: false,
    };

    let obstacles: Obstacle[] = [];
    let nextObstacle = 100;
    // Penanda eksplisit Game Over. Restart HANYA lewat tombol dialog.
    let isGameOver = false;

    if (hiScoreEl) {
      hiScoreEl.textContent = hiScore.toString().padStart(5, '0');
    }

    function showSplashScreen() {
      gameRunning = false;
      isGameOver = false;
      if (gameOverOverlay) gameOverOverlay.style.display = 'none';
      if (scoreEl) scoreEl.textContent = '00000';
      updateLeaderboard();

      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawBackground();
      
      // Draw splash text
      ctx.fillStyle = '#00ff66';
      ctx.font = '16px "Press Start 2P", monospace';
      ctx.textAlign = 'center';
      ctx.fillText('CLICK / TAP TO START', canvas.width / 2, 110);
      ctx.font = '10px "Press Start 2P", monospace';
      ctx.fillStyle = '#38bdf8';
      ctx.fillText('SPACE = JUMP | S = MODE | D/C = POWERS', canvas.width / 2, 140);
    }

    function resetGame() {
      score = 0;
      gameSpeed = 5;
      timeScale = 1;
      obstacles = [];
      player.y = 190;
      player.vy = 0;
      player.isJumping = false;
      powerActive = false;
      powerCooldown = 0;
      powerDuration = 0;
      gameRunning = true;
      isGameOver = false;
      if (gameOverOverlay) gameOverOverlay.style.display = 'none';
      updateLeaderboard();
      requestAnimationFrame(gameLoop);
    }

    function triggerJump() {
      // Jump hanya berlaku saat ronde aktif. Tidak pernah me-restart ronde.
      if (!gameRunning || isGameOver) return;
      if (!player.isJumping) {
        player.vy = player.jumpPower;
        player.isJumping = true;
      }
    }

    function startFromCanvas() {
      // Start awal hanya lewat tap/click canvas; Game Over harus memakai tombol dialog.
      if (!gameRunning && !isGameOver) {
        resetGame();
      }
    }

    function toggleGameMode() {
      mode = mode === 'developer' ? 'creative' : 'developer';
      if (modeEl) {
        modeEl.textContent = mode.toUpperCase();
        modeEl.style.color = mode === 'developer' ? 'var(--accent-primary)' : 'var(--accent-primary)';
      }
    }

    function activatePower(type: 'developer' | 'creative') {
      if (!gameRunning || powerCooldown > 0) return;
      if (type === 'developer') {
        mode = 'developer';
        powerActive = true;
        powerDuration = 120;
        timeScale = 0.5;
        powerCooldown = 180;
      } else {
        mode = 'creative';
        powerActive = true;
        powerDuration = 120;
        powerCooldown = 180;
      }
      if (modeEl) modeEl.textContent = mode.toUpperCase();
    }

    function drawBackground() {
      if (!ctx || !canvas) return;
      ctx.strokeStyle = '#00ff66';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, 210);
      ctx.lineTo(canvas.width, 210);
      ctx.stroke();

      // Scrolling background pillars
      ctx.fillStyle = 'rgba(56, 189, 248, 0.12)';
      for (let i = 0; i < 5; i++) {
        const x = (i * 200 - (frame * gameSpeed * 0.4) % 200);
        ctx.fillRect(x, 140, 40, 70);
      }
    }

    function updatePlayer() {
      player.vy += player.gravity * timeScale;
      player.y += player.vy * timeScale;

      if (player.y > 194) {
        player.y = 194;
        player.vy = 0;
        player.isJumping = false;
      }
    }

    function drawPlayer() {
      if (!ctx) return;
      const isDev = mode === 'developer';
      const pColor = isDev ? '#00ff66' : '#ff4d00';

      if (mode === 'creative' && powerActive) {
        ctx.fillStyle = 'rgba(255, 77, 0, 0.35)';
        ctx.fillRect(player.x - 24, player.y, 44, 16);
      }

      ctx.fillStyle = pColor;
      ctx.fillRect(player.x, player.y, player.width, player.height);

      // Eye
      ctx.fillStyle = '#0b0d10';
      ctx.fillRect(player.x + 10, player.y + 4, 3, 3);

      if (isDev && powerActive) {
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 2;
        ctx.strokeRect(player.x - 4, player.y - 4, player.width + 8, player.height + 8);
      }
    }

    function updateObstacles() {
      if (frame > nextObstacle) {
        obstacles.push({
          x: 800,
          y: 178,
          width: 16,
          height: 32,
          color: '#ff4d00',
        });
        nextObstacle = frame + Math.max(35, Math.floor((Math.random() * 50 + 40) / (gameSpeed / 5)));
      }

      for (let i = obstacles.length - 1; i >= 0; i--) {
        const obs = obstacles[i];
        obs.x -= gameSpeed * timeScale;
        if (obs.x + obs.width < 0) {
          obstacles.splice(i, 1);
        }
      }
    }

    function drawObstacles() {
      if (!ctx) return;
      obstacles.forEach((obs) => {
        ctx.fillStyle = obs.color;
        ctx.fillRect(obs.x, obs.y, obs.width, obs.height);

        // Bug spikes
        ctx.fillRect(obs.x - 2, obs.y + 4, 4, 2);
        ctx.fillRect(obs.x + 14, obs.y + 4, 4, 2);
        ctx.fillRect(obs.x + 4, obs.y - 2, 8, 2);
      });
    }

    function updatePowers() {
      if (powerDuration > 0) {
        powerDuration--;
        if (powerDuration <= 0) {
          powerActive = false;
          timeScale = 1;
          powerCooldown = 180;
        }
      }

      if (powerCooldown > 0) {
        powerCooldown--;
        if (powerEl) {
          powerEl.textContent = `COOLDOWN (${Math.ceil(powerCooldown / 60)}s)`;
          powerEl.style.color = '#94a3b8';
        }
      } else {
        if (powerEl) {
          powerEl.textContent = 'READY';
          powerEl.style.color = 'var(--accent-primary)';
        }
      }
    }

    function checkCollisions() {
      if (mode === 'developer' && powerActive) return;

      for (const obs of obstacles) {
        if (
          player.x < obs.x + obs.width &&
          player.x + player.width > obs.x &&
          player.y < obs.y + obs.height &&
          player.y + player.height > obs.y
        ) {
          gameOver();
          break;
        }
      }
    }

    function gameOver() {
      gameRunning = false;
      isGameOver = true; // Kunci restart otomatis sampai user klik tombol
      if (finalScoreEl) finalScoreEl.textContent = score.toString();
      if (gameOverOverlay) gameOverOverlay.style.display = 'flex';

      if (score > hiScore) {
        hiScore = score;
        localStorage.setItem('hzb-runner-hi', hiScore.toString());
        if (hiScoreEl) hiScoreEl.textContent = hiScore.toString().padStart(5, '0');
      }
    }

    function gameLoop() {
      if (!gameRunning || !ctx || !canvas) return;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      drawBackground();
      updatePlayer();
      updateObstacles();
      updatePowers();
      checkCollisions();
      drawPlayer();
      drawObstacles();

      if (frame % 5 === 0) {
        const multiplier = (mode === 'creative' && powerActive) ? 2 : 1;
        score += 1 * multiplier;
        if (scoreEl) scoreEl.textContent = score.toString().padStart(5, '0');
      }

      if (frame % 500 === 0) gameSpeed += 0.2;

      frame++;
      requestAnimationFrame(gameLoop);
    }

    // Touch controls attachment
    const touchJump = document.getElementById('touch-btn-jump');
    const touchMode = document.getElementById('touch-btn-mode');
    const touchDev = document.getElementById('touch-btn-power-dev');
    const touchCreative = document.getElementById('touch-btn-power-creative');

    const addTouchAction = (el: HTMLElement | null, action: () => void) => {
      if (!el) return;
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        action();
      });
    };

    addTouchAction(touchJump, triggerJump);
    addTouchAction(touchMode, toggleGameMode);
    addTouchAction(touchDev, () => activatePower('developer'));
    addTouchAction(touchCreative, () => activatePower('creative'));
    // Tombol mobile juga tidak boleh auto-restart: triggerJump sudah guard

    // Canvas click / tap: hanya start ronde pertama, tidak pernah auto-restart
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      startFromCanvas();
    });

    // Keyboard handlers
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

      if (!gameRunning && e.code === 'Space') {
        // Space saat idle (splash) boleh memulai ronde pertama,
        // tapi saat Game Over overlay terbuka, biarkan tombol dialog yang bekerja.
        e.preventDefault();
        startFromCanvas();
        return;
      }

      if (gameRunning) {
        if (e.code === 'Space') {
          e.preventDefault();
          triggerJump();
        } else if (e.code === 'KeyS') {
          toggleGameMode();
        } else if (e.code === 'KeyD') {
          activatePower('developer');
        } else if (e.code === 'KeyC') {
          activatePower('creative');
        }
      }
    });

    // Leaderboard
    function saveScore() {
      const name = (playerNameInput?.value || '').trim().toUpperCase() || 'PLAYER';
      const existing = localStorage.getItem('hzb-leaderboard');
      let scores: LeaderboardEntry[] = [];
      try {
        scores = existing ? JSON.parse(existing) : [];
      } catch (err) {
        scores = [];
      }

      scores.push({ name, score, mode: mode.toUpperCase() });
      scores.sort((a, b) => b.score - a.score);

      const top10 = scores.slice(0, 10);
      localStorage.setItem('hzb-leaderboard', JSON.stringify(top10));

      if (playerNameInput) playerNameInput.value = '';
      showSplashScreen();
    }

    function updateLeaderboard() {
      const existing = localStorage.getItem('hzb-leaderboard');
      let scores: LeaderboardEntry[] = [];
      try {
        scores = existing ? JSON.parse(existing) : [];
      } catch (err) {
        scores = [];
      }
      const tbody = document.getElementById('leaderboard-body');
      if (!tbody) return;

      if (scores.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 1rem;">NO SCORES YET. PLAY A ROUND!</td></tr>';
        return;
      }

      tbody.innerHTML = scores.map((s, i) => `
        <tr>
          <td><span class="rank">#${(i + 1).toString().padStart(2, '0')}</span></td>
          <td><strong>${s.name}</strong></td>
          <td>${s.score}</td>
          <td><span class="mode-tag">${s.mode}</span></td>
        </tr>
      `).join('');
    }

    // Simpan skor lalu mulai ronde baru hanya setelah aksi eksplisit user.
    saveBtn?.addEventListener('click', saveScore);
    newGameBtn?.addEventListener('click', () => {
      if (playerNameInput) playerNameInput.value = '';
      showSplashScreen();
    });

    // Klik area luar dialog Game Over TIDAK boleh me-restart game
    gameOverOverlay?.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
    });

    // Initial Splash Screen
    showSplashScreen();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGame);
  } else {
    initGame();
  }
</script>

<style>
  .game-main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-sizing: border-box;
  }

  .game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .game-title {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: clamp(1.2rem, 3vw, 1.75rem);
    color: var(--accent-primary);
    margin-bottom: 0.25rem;
  }

  .game-sub {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .status-box {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .highlight-mode {
    color: var(--accent-primary);
    font-weight: bold;
  }

  .highlight-power {
    color: var(--accent-primary);
    font-weight: bold;
  }

  .game-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .game-ui {
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 800px;
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.8rem;
    color: var(--accent-primary);
    padding: 0 0.5rem;
  }

  .canvas-wrapper {
    width: 100%;
    max-width: 800px;
    display: flex;
    justify-content: center;
  }

  #game-canvas {
    background: var(--bg-primary);
    border: 3px solid var(--border-color);
    box-shadow: var(--pixel-shadow);
    width: 100%;
    max-width: 800px;
    height: auto;
    aspect-ratio: 800 / 240;
    image-rendering: pixelated;
    touch-action: none;
    cursor: pointer;
  }

  /* Arcade Touchpad (Mobile Controls) */
  .arcade-touch-pad {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 800px;
    gap: 1rem;
    padding: 0.75rem;
    background: var(--bg-elevated);
    border: 2px solid var(--border-color);
    box-shadow: var(--pixel-shadow);
    box-sizing: border-box;
  }

  .touch-cluster-left {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .touch-cluster-right {
    display: flex;
  }

  .arcade-touch-btn {
    background: var(--bg-primary);
    border: 2px solid var(--border-color);
    color: var(--text-primary);
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    padding: 0.75rem 0.6rem;
    cursor: pointer;
    box-shadow: var(--pixel-shadow);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    user-select: none;
    min-height: 48px;
  }

  .arcade-touch-btn:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }

  .btn-top-label {
    font-size: 0.5rem;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .btn-main-label {
    font-size: 0.65rem;
  }

  .arcade-touch-btn.jump-btn {
    background: var(--accent-primary);
    color: #0b0d10;
    min-width: 110px;
    min-height: 56px;
    font-size: 0.8rem;
  }

  .arcade-touch-btn.dev {
    border-color: #38bdf8;
    color: #38bdf8;
  }

  .arcade-touch-btn.creative {
    border-color: #ff4d00;
    color: #ff4d00;
  }

  .game-controls-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    width: 100%;
    max-width: 800px;
  }

  .control-item {
    background: var(--bg-elevated);
    border: 2px solid var(--border-color);
    padding: 0.6rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
  }

  .key {
    background: var(--accent-primary);
    color: #0b0d10;
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.6rem;
    padding: 0.3rem 0.5rem;
    border-radius: 2px;
    min-width: 2.2rem;
    text-align: center;
  }

  .leaderboard-window {
    width: 100%;
    margin-top: 1rem;
  }

  .table-responsive {
    overflow-x: auto;
    width: 100%;
  }

  .leaderboard-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.8rem;
  }

  .leaderboard-table th {
    text-align: left;
    color: var(--accent-secondary);
    padding: 0.6rem;
    border-bottom: 2px solid var(--border-color);
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.65rem;
  }

  .leaderboard-table td {
    padding: 0.6rem;
    border-bottom: 1px solid rgba(0, 255, 102, 0.15);
  }

  .rank {
    color: var(--accent-primary);
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.65rem;
  }

  .mode-tag {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    padding: 2px 6px;
    font-size: 0.65rem;
  }

  .game-over-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    padding: 1rem;
  }

  .game-over-dialog {
    background: var(--bg-elevated);
    border: 4px solid #ff4d00;
    padding: 2rem;
    text-align: center;
    max-width: 420px;
    width: 100%;
    box-shadow: var(--pixel-shadow);
  }

  .game-over-title {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 1.5rem;
    color: #ff4d00;
    margin-bottom: 1rem;
  }

  .final-score {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 1rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .name-input {
