---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
---

<BaseLayout title="PIXEL RUNNER | HZB Portfolio">
  <main class="game-main">
    <section class="game-header">
      <div class="title-area">
        <h1 class="game-title">PIXEL RUNNER</h1>
        <p class="game-sub">ENDLESS 8-BIT RUNNER // SAVE_SCORE.EXE</p>
      </div>
      <div class="game-stats">
        <RetroWindow title="GAME STATUS" type="sys">
          <div id="game-state-ui" class="status-box">
            MODE: <span id="current-mode" class="highlight-mode">DEVELOPER</span><br>
            POWER: <span id="power-status" class="highlight-power">READY</span>
          </div>
        </RetroWindow>
      </div>
    </section>

    <div class="game-container">
      <div class="game-ui">
        <div class="ui-score">SCORE: <span id="score-val">00000</span></div>
        <div class="ui-highscore">HI-SCORE: <span id="hi-score-val">00000</span></div>
      </div>

      <div class="canvas-wrapper">
        <canvas id="game-canvas" width="800" height="240" role="img" aria-label="Pixel runner mini game canvas"></canvas>
      </div>

      <!-- On-Screen Arcade Touch Controls for Mobile Users -->
      <div class="arcade-touch-pad" id="arcade-touch-controls" aria-label="Arcade Controls">
        <div class="touch-cluster-left">
          <button id="touch-btn-mode" class="arcade-touch-btn secondary" type="button" aria-label="Toggle Mode">
            <span class="btn-top-label">[S]</span>
            <span class="btn-main-label">MODE</span>
          </button>
          <button id="touch-btn-power-dev" class="arcade-touch-btn dev" type="button" aria-label="Slow-Mo Power">
            <span class="btn-top-label">[D]</span>
            <span class="btn-main-label">SLOW-MO</span>
          </button>
          <button id="touch-btn-power-creative" class="arcade-touch-btn creative" type="button" aria-label="Dash Power">
            <span class="btn-top-label">[C]</span>
            <span class="btn-main-label">2X DASH</span>
          </button>
        </div>

        <div class="touch-cluster-right">
          <button id="touch-btn-jump" class="arcade-touch-btn jump-btn" type="button" aria-label="Jump / Action">
            <span class="btn-top-label">[SPACE]</span>
            <span class="btn-main-label">JUMP</span>
          </button>
        </div>
      </div>

      <div class="game-controls-info">
        <div class="control-item">
          <span class="key">SPACE / TAP</span>
          <span>JUMP / START</span>
        </div>
        <div class="control-item">
          <span class="key">S</span>
          <span>TOGGLE MODE</span>
        </div>
        <div class="control-item">
          <span class="key">D</span>
          <span>DEV SLOW-MO</span>
        </div>
        <div class="control-item">
          <span class="key">C</span>
          <span>CREATIVE 2X DASH</span>
        </div>
      </div>
    </div>

    <RetroWindow title="LOCAL LEADERBOARD (TOP 10)" type="sys" class="leaderboard-window">
      <div class="table-responsive">
        <table class="leaderboard-table">
          <thead>
            <tr>
              <th>RANK</th>
              <th>NAME</th>
              <th>SCORE</th>
              <th>MODE</th>
            </tr>
          </thead>
          <tbody id="leaderboard-body">
            <!-- Populated by JS -->
          </tbody>
        </table>
      </div>
    </RetroWindow>
  </main>

  <!-- Game Over Overlay -->
  <div id="game-over-overlay" class="game-over-overlay" style="display: none;">
    <div class="game-over-dialog">
      <h2 class="game-over-title">GAME OVER</h2>
      <p class="final-score">SCORE: <span id="final-score-val">0</span></p>
      <input type="text" id="player-name" class="name-input" maxlength="8" placeholder="ENTER NAME" />
      <button id="save-score-btn" class="save-btn" type="button">SAVE & RESTART</button>
      <button id="new-game-btn" class="new-game-btn" type="button">NEW GAME</button>
    </div>
  </div>
</BaseLayout>

<script>
  interface Obstacle {
    x: number;
    y: number;
    width: number;
    height: number;
    color: string;
    type?: 'low' | 'tall' | 'flyer' | 'double';
  }

  interface LeaderboardEntry {
    name: string;
    score: number;
    mode: string;
  }

  function initGame() {
    const canvas = document.getElementById('game-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const scoreEl = document.getElementById('score-val');
    const hiScoreEl = document.getElementById('hi-score-val');
    const modeEl = document.getElementById('current-mode');
    const powerEl = document.getElementById('power-status');
    const gameOverOverlay = document.getElementById('game-over-overlay') as HTMLElement | null;
    const finalScoreEl = document.getElementById('final-score-val');
    const playerNameInput = document.getElementById('player-name') as HTMLInputElement | null;
    const saveBtn = document.getElementById('save-score-btn') as HTMLButtonElement | null;
    const newGameBtn = document.getElementById('new-game-btn') as HTMLButtonElement | null;

    // Game state
    let gameRunning = false;
    let score = 0;
    let hiScore = parseInt(localStorage.getItem('hzb-runner-hi') || '0', 10) || 0;
    let frame = 0;
    let gameSpeed = 3.6;
    let timeScale = 1;
    let mode = 'developer';
    let powerActive = false;
    let powerCooldown = 0;
    let powerDuration = 0;

    // Player config (lincah, terukur, dan nyaman ala Dino Game)
    const player = {
      x: 80,
      y: 194,
      width: 16,
      height: 16,
      vy: 0,
      gravity: 0.58,
      jumpPower: -10.5,
      isJumping: false,
    };

    let obstacles: Obstacle[] = [];
    let nextObstacle = 140;
    let jumpBuffer = 0;
    // Penanda eksplisit Game Over. Restart HANYA lewat tombol dialog.
    let isGameOver = false;

    if (hiScoreEl) {
      hiScoreEl.textContent = hiScore.toString().padStart(5, '0');
    }

    function showSplashScreen() {
      gameRunning = false;
      isGameOver = false;
      stopLoop();
      if (gameOverOverlay) gameOverOverlay.style.display = 'none';
      if (scoreEl) scoreEl.textContent = '00000';
      updateLeaderboard();

      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawBackground();
      
      // Draw splash text
      ctx.fillStyle = '#00ff66';
      ctx.font = '16px "Press Start 2P", monospace';
      ctx.textAlign = 'center';
      ctx.fillText('CLICK / TAP TO START', canvas.width / 2, 110);
      ctx.font = '10px "Press Start 2P", monospace';
      ctx.fillStyle = '#38bdf8';
      ctx.fillText('SPACE = JUMP | S = MODE | D/C = POWERS', canvas.width / 2, 140);
    }

    function resetGame() {
      score = 0;
      frame = 0;
      gameSpeed = 3.6;
      timeScale = 1;
      obstacles = [];
      nextObstacle = 140; // Memberi jeda santai ~2.3 detik sebelum rintangan pertama
      jumpBuffer = 0;
      player.y = 194;
      player.vy = 0;
      player.isJumping = false;
      powerActive = false;
      powerCooldown = 0;
      powerDuration = 0;
      gameRunning = true;
      isGameOver = false;
      lastTime = performance.now();
      if (gameOverOverlay) gameOverOverlay.style.display = 'none';
      updateLeaderboard();
      stopLoop();
      startLoop();
    }

    function triggerJump() {
      // Jump hanya berlaku saat ronde aktif. Tidak pernah me-restart ronde.
      if (!gameRunning || isGameOver) return;
      if (!player.isJumping) {
        player.vy = player.jumpPower;
        player.isJumping = true;
        jumpBuffer = 0;
      } else {
        // Buffer jump input jika player sedikit lagi mendarat (~130ms)
        jumpBuffer = 8;
      }
    }

    function startFromCanvas() {
      // Start awal hanya lewat tap/click canvas; Game Over harus memakai tombol dialog.
      if (!gameRunning && !isGameOver) {
        resetGame();
      }
    }

    function toggleGameMode() {
      mode = mode === 'developer' ? 'creative' : 'developer';
      if (modeEl) {
        modeEl.textContent = mode.toUpperCase();
        modeEl.style.color = mode === 'developer' ? 'var(--accent-primary)' : 'var(--accent-primary)';
      }
    }

    function activatePower(type: 'developer' | 'creative') {
      if (!gameRunning || powerCooldown > 0) return;
      if (type === 'developer') {
        mode = 'developer';
        powerActive = true;
        powerDuration = 120;
        timeScale = 0.5;
        powerCooldown = 180;
      } else {
        mode = 'creative';
        powerActive = true;
        powerDuration = 120;
        powerCooldown = 180;
      }
      if (modeEl) modeEl.textContent = mode.toUpperCase();
    }

    function drawBackground() {
      if (!ctx || !canvas) return;
      ctx.strokeStyle = '#00ff66';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, 210);
      ctx.lineTo(canvas.width, 210);
      ctx.stroke();

      // Scrolling background pillars
      ctx.fillStyle = 'rgba(56, 189, 248, 0.12)';
      for (let i = 0; i < 5; i++) {
        const x = (i * 200 - (frame * gameSpeed * 0.4) % 200);
        ctx.fillRect(x, 140, 40, 70);
      }
    }

    let lastTime = performance.now();
    let rafId: number | null = null;

    function startLoop() {
      if (rafId !== null) return;
      rafId = requestAnimationFrame(gameLoop);
    }

    function stopLoop() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    function drawPlayer() {
      if (!ctx) return;
      const isDev = mode === 'developer';
      const pColor = isDev ? '#00ff66' : '#ff4d00';

      if (mode === 'creative' && powerActive) {
        ctx.fillStyle = 'rgba(255, 77, 0, 0.35)';
        ctx.fillRect(player.x - 24, player.y, 44, 16);
      }

      ctx.fillStyle = pColor;
      ctx.fillRect(player.x, player.y, player.width, player.height);

      // Eye
      ctx.fillStyle = '#0b0d10';
      ctx.fillRect(player.x + 10, player.y + 4, 3, 3);

      if (isDev && powerActive) {
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 2;
        ctx.strokeRect(player.x - 4, player.y - 4, player.width + 8, player.height + 8);
      }
    }

    function drawObstacles() {
      if (!ctx) return;
      obstacles.forEach((obs) => {
        if (obs.type === 'flyer') {
          // Cyber Bird / Pterodactyl ala Chrome Dino (terbang di atas)
          const wingUp = (Math.floor(frame / 8) % 2 === 0);
          ctx.fillStyle = '#38bdf8';
          // Badan
          ctx.fillRect(obs.x + 4, obs.y + 4, 12, 5);
          // Kepala & paruh
          ctx.fillRect(obs.x, obs.y + 2, 4, 4);
          ctx.fillRect(obs.x - 2, obs.y + 3, 2, 2);
          // Mata
          ctx.fillStyle = '#0b0d10';
          ctx.fillRect(obs.x + 1, obs.y + 3, 1, 1);
          // Sayap mengepak
          ctx.fillStyle = '#38bdf8';
          if (wingUp) {
            ctx.fillRect(obs.x + 7, obs.y - 4, 5, 8);
          } else {
            ctx.fillRect(obs.x + 7, obs.y + 7, 5, 7);
          }
        } else if (obs.type === 'low') {
          // Rintangan Rendah (Small Cactus 14px - sangat mudah dilompati)
          ctx.fillStyle = obs.color;
          ctx.fillRect(obs.x, obs.y, obs.width, obs.height);
          // Detail duri atas
          ctx.fillRect(obs.x + 3, obs.y - 2, obs.width - 6, 2);
          ctx.fillStyle = '#0b0d10';
          ctx.fillRect(obs.x + 3, obs.y + 3, 2, obs.height - 6);
        } else if (obs.type === 'double') {
          // Rintangan Ganda Rendah (Dua kaktus kecil 14px berdampingan)
          ctx.fillStyle = obs.color;
          ctx.fillRect(obs.x, obs.y, 10, obs.height);
          ctx.fillRect(obs.x + 14, obs.y + 2, 10, obs.height - 2);
          ctx.fillStyle = '#0b0d10';
          ctx.fillRect(obs.x + 3, obs.y + 3, 2, obs.height - 6);
          ctx.fillRect(obs.x + 17, obs.y + 5, 2, obs.height - 8);
        } else {
          // Rintangan Tinggi (Tall Cactus 24px - dengan cabang samping)
          ctx.fillStyle = obs.color;
          ctx.fillRect(obs.x, obs.y, obs.width, obs.height);
          // Cabang kiri & kanan
          ctx.fillRect(obs.x - 3, obs.y + 6, 3, 6);
          ctx.fillRect(obs.x - 3, obs.y + 6, 5, 2);
          ctx.fillRect(obs.x + obs.width, obs.y + 10, 3, 6);
          ctx.fillRect(obs.x + obs.width - 2, obs.y + 10, 5, 2);
          ctx.fillStyle = '#0b0d10';
          ctx.fillRect(obs.x + 4, obs.y + 4, 2, obs.height - 8);
        }
      });
    }

    function checkCollisions() {
      if (mode === 'developer' && powerActive) return;

      // Hitbox pemaaf (padding 3px horizontal, 2px vertikal)
      const pLeft = player.x + 3;
      const pRight = player.x + player.width - 3;
      const pTop = player.y + 2;
      const pBottom = player.y + player.height - 1;

      for (const obs of obstacles) {
        const oPaddingX = (obs.type === 'flyer') ? 1 : 2;
        const oLeft = obs.x + oPaddingX;
        const oRight = obs.x + obs.width - oPaddingX;
        const oTop = obs.y + 2;
        const oBottom = obs.y + obs.height - 1;

        if (
          pLeft < oRight &&
          pRight > oLeft &&
          pTop < oBottom &&
          pBottom > oTop
        ) {
          gameOver();
          break;
        }
      }
    }

    function gameOver() {
      gameRunning = false;
      isGameOver = true;
      stopLoop();
      if (finalScoreEl) finalScoreEl.textContent = score.toString();
      if (gameOverOverlay) gameOverOverlay.style.display = 'flex';

      if (score > hiScore) {
        hiScore = score;
        localStorage.setItem('hzb-runner-hi', hiScore.toString());
        if (hiScoreEl) hiScoreEl.textContent = hiScore.toString().padStart(5, '0');
      }
    }

    function gameLoop(currentTime = performance.now()) {
      if (!gameRunning || !ctx || !canvas || rafId === null) return;

      const dt = Math.min((currentTime - lastTime) / 1000, 0.1);
      lastTime = currentTime;
      const step = dt * 60; // Normalize to 60fps base ticks

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      drawBackground();
      
      // Update with dt scaling
      player.vy += player.gravity * timeScale * step;
      player.y += player.vy * step;

      if (player.y > 194) {
        player.y = 194;
        player.vy = 0;
        player.isJumping = false;
      }

      // Jump buffer: jika player menekan tombol sedikit sebelum mendarat, langsung lompat saat menyentuh tanah
      if (jumpBuffer > 0) {
        if (!player.isJumping) {
          player.vy = player.jumpPower;
          player.isJumping = true;
          jumpBuffer = 0;
        } else {
          jumpBuffer -= step;
        }
      }

      if (frame > nextObstacle) {
        // Tentukan tipe rintangan berdasarkan skor (seperti Chrome Dino Game)
        let type: 'low' | 'tall' | 'flyer' | 'double' = 'low';
        let w = 12;
        let h = 14;
        let y = 196; // 210 - 14 (di tanah)
        let color = '#ff4d00';

        const rand = Math.random();
        if (score < 100) {
          // Fase 1: 100% rintangan rendah (14px) - santai dan sangat mudah dilompati
          type = 'low';
          w = 12;
          h = 14;
          y = 196;
        } else if (score < 300) {
          // Fase 2: Rintangan rendah (60%), kaktus tinggi 24px (25%), burung terbang tinggi (15%)
          if (rand < 0.60) {
            type = 'low';
            w = 12;
            h = 14;
            y = 196;
          } else if (rand < 0.85) {
            type = 'tall';
            w = 14;
            h = 24;
            y = 186; // 210 - 24
          } else {
            type = 'flyer';
            w = 20;
            h = 12;
            y = 156; // Burung terbang tinggi di atas kepala player (aman dilewati sambil lari tanpa lompat!)
            color = '#38bdf8';
          }
        } else {
          // Fase 3: Variasi lengkap (rendah, ganda, tinggi, burung)
          if (rand < 0.35) {
            type = 'low';
            w = 12;
            h = 14;
            y = 196;
          } else if (rand < 0.60) {
            type = 'tall';
            w = 14;
            h = 24;
            y = 186;
          } else if (rand < 0.80) {
            type = 'double';
            w = 24;
            h = 14;
            y = 196;
          } else {
            type = 'flyer';
            w = 20;
            h = 12;
            y = 156;
            color = '#38bdf8';
          }
        }

        obstacles.push({
          x: 800,
          y,
          width: w,
          height: h,
          color,
          type,
        });

        // Jarak rintangan luas dan teratur seperti Dino game (minimal 78 frame / ~1.4 - 2.8 detik)
        const minGap = Math.max(78, 115 - Math.floor(score / 25));
        const randomBonus = Math.floor(Math.random() * 65);
        nextObstacle = frame + Math.floor((minGap + randomBonus) / (gameSpeed / 3.6));
      }

      for (let i = obstacles.length - 1; i >= 0; i--) {
        const obs = obstacles[i];
        obs.x -= gameSpeed * timeScale * step;
        if (obs.x + obs.width < 0) {
          obstacles.splice(i, 1);
        }
      }

      if (powerDuration > 0) {
        powerDuration -= step;
        if (powerDuration <= 0) {
          powerActive = false;
          timeScale = 1;
          powerCooldown = 180;
        }
      }

      if (powerCooldown > 0) {
        powerCooldown -= step;
        if (powerEl) {
          powerEl.textContent = `COOLDOWN (${Math.ceil(powerCooldown / 60)}s)`;
          powerEl.style.color = '#94a3b8';
        }
      } else {
        if (powerEl) {
          powerEl.textContent = 'READY';
          powerEl.style.color = 'var(--accent-primary)';
        }
      }

      checkCollisions();
      drawPlayer();
      drawObstacles();

      if (frame % 5 === 0) {
        const multiplier = (mode === 'creative' && powerActive) ? 2 : 1;
        score += 1 * multiplier;
        if (scoreEl) scoreEl.textContent = score.toString().padStart(5, '0');
      }

      // Kenaikan kecepatan sangat halus dan stabil seperti Dino Game (max 6.0)
      if (frame % 600 === 0 && gameSpeed < 6.0) gameSpeed += 0.08;

      frame++;
      rafId = requestAnimationFrame(gameLoop);
    }

    // Touch controls attachment
    const touchJump = document.getElementById('touch-btn-jump');
    const touchMode = document.getElementById('touch-btn-mode');
    const touchDev = document.getElementById('touch-btn-power-dev');
    const touchCreative = document.getElementById('touch-btn-power-creative');

    const addTouchAction = (el: HTMLElement | null, action: () => void) => {
      if (!el) return;
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        action();
      });
    };

    addTouchAction(touchJump, triggerJump);
    addTouchAction(touchMode, toggleGameMode);
    addTouchAction(touchDev, () => activatePower('developer'));
    addTouchAction(touchCreative, () => activatePower('creative'));
    // Tombol mobile juga tidak boleh auto-restart: triggerJump sudah guard

    // Canvas click / tap: hanya start ronde pertama, tidak pernah auto-restart
    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      startFromCanvas();
    });

    // Keyboard handlers
    const handleKeydown = (e: KeyboardEvent) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

      if (!gameRunning && e.code === 'Space') {
        e.preventDefault();
        startFromCanvas();
        return;
      }

      if (gameRunning) {
        if (e.code === 'Space') {
          e.preventDefault();
          triggerJump();
        } else if (e.code === 'KeyS') {
          toggleGameMode();
        } else if (e.code === 'KeyD') {
          activatePower('developer');
        } else if (e.code === 'KeyC') {
          activatePower('creative');
        }
      }
    };
    window.addEventListener('keydown', handleKeydown);

    const handleVisibility = () => {
      if (document.hidden) {
        stopLoop();
      } else if (gameRunning && !isGameOver) {
        lastTime = performance.now();
        startLoop();
      }
    };
    document.addEventListener('visibilitychange', handleVisibility);

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          if (gameRunning && !isGameOver) {
            lastTime = performance.now();
            startLoop();
          }
        } else {
          stopLoop();
        }
      }
    }, { threshold: 0.05 });
    observer.observe(canvas);

    window.addEventListener('pagehide', () => {
      stopLoop();
      observer.disconnect();
      window.removeEventListener('keydown', handleKeydown);
      document.removeEventListener('visibilitychange', handleVisibility);
    }, { once: true });

    // Leaderboard
    function saveScore() {
      const name = (playerNameInput?.value || '').trim().toUpperCase() || 'PLAYER';
      const existing = localStorage.getItem('hzb-leaderboard');
      let scores: LeaderboardEntry[] = [];
      try {
        scores = existing ? JSON.parse(existing) : [];
      } catch (err) {
        scores = [];
      }

      scores.push({ name, score, mode: mode.toUpperCase() });
      scores.sort((a, b) => b.score - a.score);

      const top10 = scores.slice(0, 10);
      localStorage.setItem('hzb-leaderboard', JSON.stringify(top10));

      if (playerNameInput) playerNameInput.value = '';
      showSplashScreen();
    }

    function updateLeaderboard() {
      const existing = localStorage.getItem('hzb-leaderboard');
      let scores: LeaderboardEntry[] = [];
      try {
        scores = existing ? JSON.parse(existing) : [];
      } catch (err) {
        scores = [];
      }
      const tbody = document.getElementById('leaderboard-body');
      if (!tbody) return;

      if (scores.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 1rem;">NO SCORES YET. PLAY A ROUND!</td></tr>';
        return;
      }

      tbody.innerHTML = '';
      scores.forEach((s, i) => {
        const tr = document.createElement('tr');
        const rankTd = document.createElement('td');
        rankTd.innerHTML = `<span class="rank">#${(i + 1).toString().padStart(2, '0')}</span>`;
        const nameTd = document.createElement('td');
        const strong = document.createElement('strong');
        strong.textContent = s.name;
        nameTd.appendChild(strong);
        const scoreTd = document.createElement('td');
        scoreTd.textContent = s.score.toString();
        const modeTd = document.createElement('td');
        modeTd.innerHTML = `<span class="mode-tag">${s.mode}</span>`;
        tr.append(rankTd, nameTd, scoreTd, modeTd);
        tbody.appendChild(tr);
      });
    }

    // Simpan skor lalu mulai ronde baru hanya setelah aksi eksplisit user.
    saveBtn?.addEventListener('click', saveScore);
    newGameBtn?.addEventListener('click', () => {
      if (playerNameInput) playerNameInput.value = '';
      showSplashScreen();
    });

    // Klik area luar dialog Game Over TIDAK boleh me-restart game
    gameOverOverlay?.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
    });

    // Initial Splash Screen
    showSplashScreen();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGame);
  } else {
    initGame();
  }
</script>

<style>
  .game-main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-sizing: border-box;
  }

