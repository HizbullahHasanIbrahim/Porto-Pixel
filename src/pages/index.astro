      <svg viewBox="0 0 120 100" shape-rendering="crispEdges" class="brain-svg" aria-hidden="true">
        <g class="brain-part">
          <rect x="30" y="10" width="60" height="12" fill="var(--accent-primary)" />
        </g>
        <g class="brain-part">
          <rect x="20" y="22" width="80" height="40" fill="var(--accent-primary)" />
          <rect x="35" y="24" width="10" height="36" fill="var(--bg-primary)" />
          <rect x="45" y="30" width="10" height="30" fill="var(--bg-primary)" />
          <rect x="65" y="30" width="10" height="30" fill="var(--bg-primary)" />
          <rect x="75" y="24" width="10" height="36" fill="var(--bg-primary)" />
        </g>
        <g class="brain-part">
