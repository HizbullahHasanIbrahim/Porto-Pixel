      gsap.from('#dna-strand', { scrollTrigger: { trigger: '#dna', start: 'top 85%' }, opacity: 0, scale: 0.9, duration: 0.8 });
      gsap.from('.dna-text', {
        scrollTrigger: {
          trigger: '#dna',
          start: 'top 85%',
          onEnter: () => {
            document.querySelectorAll('.dna-highlight').forEach((el, idx) => {
              setTimeout(() => el.classList.add('active'), idx * 250);
            });
          },
