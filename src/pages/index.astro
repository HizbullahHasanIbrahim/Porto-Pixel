---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
import SectionNav from '../components/SectionNav.astro';
import PixelIcons from '../components/PixelIcons.astro';
---

<BaseLayout title="HZB // Creative Developer & IS Architect">
  <SectionNav sections={[
    { id: 'hero', label: 'HERO' },
    { id: 'creator', label: 'CREATOR' },
    { id: 'pixels', label: 'PIXELS' },
    { id: 'brain', label: 'BRAIN' },
    { id: 'windows', label: 'WINDOWS' },
    { id: 'tetris', label: 'ARCADE' },
    { id: 'contact', label: 'CONTACT' },
  ]} />

  <!-- SECTION 1: HERO -->
  <section id="hero" class="story-section hero-section">
    <div class="hero-content" id="hero-enter">
      <div class="terminal-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">STATUS: LVL 99 SYSTEM READY // PORT 4321</span>
      </div>

      <h1 class="hero-title">
        <span class="glitch-text" data-text="HIZBULLAH">HIZBULLAH</span>
        <span class="title-sub">HASAN IBRAHIM</span>
      </h1>

      <p class="hero-tagline">
        <span class="highlight">Sistem Informasi</span> &amp; <span class="highlight-alt">Creative Web Developer</span>.
        Menghubungkan arsitektur data terstruktur dengan pengalaman visual 8-bit retro yang interaktif.
      </p>

      <div class="hero-avatar-box">
        <!-- Floating Decor Artifacts -->
        <div class="floating-pixel-art f-1" style="top: -20px; left: -40px;"><PixelIcons name="heart" size={16} /></div>
        <div class="floating-pixel-art f-2" style="bottom: 0px; right: -50px; animation-delay: -1s;"><PixelIcons name="pacman" size={16} /></div>
        <div class="floating-pixel-art f-3" style="top: 20px; right: -40px; animation-delay: -2s;"><PixelIcons name="trophy" size={16} /></div>

        <div class="pixel-character">
          <svg viewBox="0 0 48 48" class="char-svg" shape-rendering="crispEdges">
            <!-- Retro 8-bit Character -->
            <rect width="48" height="48" fill="#141820" />
            <!-- Hat / Hair -->
            <rect x="14" y="6" width="20" height="4" fill="#00ff66" />
            <rect x="10" y="10" width="28" height="6" fill="#00ff66" />
            <!-- Face -->
            <rect x="12" y="16" width="24" height="12" fill="#f1f5f9" />
            <!-- Pixel Glasses -->
            <rect x="14" y="18" width="8" height="6" fill="#0b0d10" />
            <rect x="26" y="18" width="8" height="6" fill="#0b0d10" />
            <rect x="22" y="20" width="4" height="2" fill="#0b0d10" />
            <rect x="16" y="20" width="4" height="2" fill="#38bdf8" />
            <rect x="28" y="20" width="4" height="2" fill="#38bdf8" />
            <!-- Smile -->
            <rect x="20" y="25" width="8" height="2" fill="#0b0d10" />
            <!-- Shirt / Body -->
            <rect x="12" y="28" width="24" height="14" fill="#141820" stroke="#00ff66" stroke-width="2" />
            <rect x="22" y="30" width="4" height="8" fill="#38bdf8" />
            <!-- Feet -->
            <rect x="14" y="42" width="8" height="4" fill="#00ff66" />
            <rect x="26" y="42" width="8" height="4" fill="#00ff66" />
          </svg>
        </div>
      </div>

      <div class="hero-cta-group">
        <a href="/projects" class="pixel-btn primary">
          <PixelIcons name="claw" size={14} />
          <span>PROJECT GALLERY</span>
        </a>
        <a href="/game" class="pixel-btn secondary">
          <PixelIcons name="pacman" size={14} />
          <span>PLAY RUNNER</span>
        </a>
        <a href="#contact" class="pixel-btn outline">
          <PixelIcons name="terminal" size={14} />
          <span>CONTACT.EXE</span>
        </a>
      </div>

      <div class="scroll-prompt">
        <span class="prompt-text">SCROLL TO INITIALIZE</span>
        <span class="prompt-arrow">▼</span>
      </div>
    </div>
  </section>

  <!-- SECTION 2: CREATOR LVL -->
  <section id="creator" class="story-section creator-section">
    <div class="section-container" id="creator-enter">
      <div class="section-titlebar">
        <span class="sect-num">01/</span>
        <h2 class="sect-title">CREATOR STATS</h2>
      </div>

      <div class="creator-cards-grid">
        <RetroWindow title="STATUS_SHEET.EXE" type="exe" class="stat-window">
          <div class="rpg-stats">
            <div class="rpg-header">
              <span class="lvl-badge">LVL 99 DEVELOPER</span>
              <span class="class-title">CLASS: DUAL-SPEC ARCHITECT</span>
            </div>

            <div class="stat-bars">
              <div class="stat-row">
                <span class="stat-name">SYSTEMS ANALYSIS (SQL / 3NF)</span>
                <div class="bar-container"><div class="bar-fill" style="width: 95%;"></div></div>
                <span class="stat-val">95/100</span>
              </div>
              <div class="stat-row">
                <span class="stat-name">FRONTEND CREATIVE (GSAP / CANVAS)</span>
                <div class="bar-container"><div class="bar-fill alt" style="width: 90%;"></div></div>
                <span class="stat-val">90/100</span>
              </div>
              <div class="stat-row">
                <span class="stat-name">MICROSERVICES &amp; SSR (ASTRO / NODE)</span>
                <div class="bar-container"><div class="bar-fill" style="width: 88%;"></div></div>
                <span class="stat-val">88/100</span>
              </div>
              <div class="stat-row">
                <span class="stat-name">HACKATHON SPEED-RUNNING</span>
                <div class="bar-container"><div class="bar-fill warn" style="width: 98%;"></div></div>
                <span class="stat-val">98/100</span>
              </div>
            </div>

            <div class="special-perks">
              <div class="perk-tag">
                <PixelIcons name="trophy" size={14} />
                <span>CODEQUEST 2024 CHAMPION</span>
              </div>
              <div class="perk-tag">
                <PixelIcons name="coffee" size={14} />
                <span>ZERO BLUR SHADOW PHILOSOPHY</span>
              </div>
            </div>
          </div>
        </RetroWindow>

        <RetroWindow title="INVENTORY.SYS" type="sys" class="inventory-window">
          <div class="inventory-grid">
            <div class="inv-slot" title="Astro SSG">
              <span class="inv-code">ASTRO</span>
              <span class="inv-meta">v5 Core</span>
            </div>
            <div class="inv-slot" title="GSAP Animation">
              <span class="inv-code">GSAP</span>
              <span class="inv-meta">ScrollTrigger</span>
            </div>
            <div class="inv-slot" title="TypeScript">
              <span class="inv-code">TS</span>
              <span class="inv-meta">Strict</span>
            </div>
            <div class="inv-slot" title="HTML5 Canvas">
              <span class="inv-code">CANVAS</span>
              <span class="inv-meta">2D Engine</span>
            </div>
            <div class="inv-slot" title="SQL Database">
              <span class="inv-code">SQL</span>
              <span class="inv-meta">Postgres/MySQL</span>
            </div>
            <div class="inv-slot" title="Laravel / PHP">
              <span class="inv-code">LARAVEL</span>
              <span class="inv-meta">Backend API</span>
            </div>
          </div>
        </RetroWindow>
      </div>
    </div>
  </section>

  <!-- SECTION 3: PIXELS (INTERACTIVE CANVAS PLAYGROUND) -->
  <section id="pixels" class="story-section pixels-section">
    <div class="section-container" id="pixels-enter">
      <div class="section-titlebar">
        <span class="sect-num">02/</span>
        <h2 class="sect-title">PIXEL MATRIX</h2>
      </div>

      <RetroWindow title="PIXEL_PLAYGROUND.SYS" type="sys" class="playground-window">
        <div class="playground-desc">
          <p>Hover cursor atau usap jarimu di layar untuk menyalakan pixel grid secara interaktif!</p>
        </div>
        <div class="matrix-canvas-box">
          <canvas id="pixel-matrix-canvas" width="600" height="240"></canvas>
        </div>
        <div class="matrix-controls">
          <button id="matrix-clear-btn" class="pixel-mini-btn" type="button">CLEAR MATRIX</button>
          <button id="matrix-rand-btn" class="pixel-mini-btn" type="button">GLITCH BURST</button>
        </div>
      </RetroWindow>
    </div>
  </section>

  <!-- SECTION 4: BRAIN / DNA (DUAL ARCHITECTURE) -->
