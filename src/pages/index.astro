---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
import SectionNav from '../components/SectionNav.astro';
import PixelIcons from '../components/PixelIcons.astro';
---

<BaseLayout title="HZB // Creative Developer & IS Architect">
  <div id="scroll-progress-line" class="scroll-progress-line" aria-hidden="true"></div>
  <SectionNav sections={[
    { id: 'hero', label: 'HERO' },
    { id: 'about', label: 'ABOUT' },
    { id: 'pixels', label: 'PIXELS' },
    { id: 'ideas', label: 'IDEAS' },
    { id: 'brain-section', label: 'BRAIN' },
    { id: 'dna', label: 'DNA' },
    { id: 'emotion', label: 'EMOTION' },
    { id: 'beauty', label: 'BEAUTY' },
    { id: 'hands', label: 'HANDS' },
    { id: 'windows', label: 'WINDOWS' },
    { id: 'tetris', label: 'TETRIS' },
    { id: 'world', label: 'WORLD' },
  ]} />

  <!-- SECTION 1: HERO - Multilingual Greeting & Dual-Mode Hero -->
  <section id="hero" class="story-section hero-section">
    <div class="hero-content">
      <div class="terminal-badge">
        <span class="badge-dot"></span>
        <span class="badge-text" id="terminal-badge-text">STATUS: SYSTEM ONLINE // PORT 4321</span>
      </div>

      <h1 class="hero-title">
        <span class="glitch-text" data-text="HIZBULLAH" id="hero-glitch-name">HIZBULLAH</span>
        <span class="title-sub" id="hero-title-sub">HASAN IBRAHIM</span>
      </h1>

      <p class="hero-headline">
        <span class="highlight">Turning Pixels</span> into <span class="highlight-alt">Memorable Digital Experiences.</span>
      </p>
      <p class="hero-subheadline">
        Seamless code and thoughtful design, crafting visions to life.
      </p>

      <div class="hero-avatar-box">
        <div class="pixel-character">
          <div class="avatar-scanline" aria-hidden="true"></div>
          <!-- Developer Mode Character -->
          <svg viewBox="0 0 48 48" class="char-svg char-dev" shape-rendering="crispEdges" aria-hidden="true">
            <rect width="48" height="48" fill="#141820" />
            <rect x="14" y="6" width="20" height="4" fill="#00ff66" />
            <rect x="10" y="10" width="28" height="6" fill="#00ff66" />
            <rect x="12" y="16" width="24" height="12" fill="#f1f5f9" />
            <rect x="14" y="18" width="8" height="6" fill="#0b0d10" />
            <rect x="26" y="18" width="8" height="6" fill="#0b0d10" />
            <rect x="22" y="20" width="4" height="2" fill="#0b0d10" />
            <rect x="16" y="20" width="4" height="2" fill="#38bdf8" />
            <rect x="28" y="20" width="4" height="2" fill="#38bdf8" />
            <rect x="20" y="25" width="8" height="2" fill="#0b0d10" />
            <rect x="12" y="28" width="24" height="14" fill="#141820" stroke="#00ff66" stroke-width="2" />
            <rect x="22" y="30" width="4" height="8" fill="#38bdf8" />
            <rect x="14" y="42" width="8" height="4" fill="#00ff66" />
            <rect x="26" y="42" width="8" height="4" fill="#00ff66" />
          </svg>
          <!-- Creative Mode Character -->
          <svg viewBox="0 0 48 48" class="char-svg char-creative" shape-rendering="crispEdges" aria-hidden="true" style="display:none">
            <rect width="48" height="48" fill="#ffffff" />
            <rect x="14" y="6" width="20" height="4" fill="#ff4d00" />
            <rect x="10" y="10" width="28" height="6" fill="#ff4d00" />
            <rect x="12" y="16" width="24" height="12" fill="#18181b" />
            <rect x="14" y="18" width="8" height="6" fill="#f4f1ea" />
            <rect x="26" y="18" width="8" height="6" fill="#f4f1ea" />
            <rect x="22" y="20" width="4" height="2" fill="#18181b" />
            <rect x="16" y="20" width="4" height="2" fill="#7c3aed" />
            <rect x="28" y="20" width="4" height="2" fill="#7c3aed" />
            <rect x="20" y="25" width="8" height="2" fill="#18181b" />
            <rect x="12" y="28" width="24" height="14" fill="#ffffff" stroke="#ff4d00" stroke-width="2" />
            <rect x="22" y="30" width="4" height="8" fill="#7c3aed" />
            <rect x="14" y="42" width="8" height="4" fill="#ff4d00" />
            <rect x="26" y="42" width="8" height="4" fill="#ff4d00" />
          </svg>
        </div>
      </div>

      <div class="mode-toggle-group">
        <button class="mode-btn dev-mode active" data-mode="developer" type="button">
          <svg class="mode-symbol" viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges" fill="currentColor">
            <rect x="2" y="2" width="12" height="12" stroke="currentColor" stroke-width="1" fill="none" />
            <rect class="mode-symbol-cutout" x="4" y="4" width="8" height="8" />
            <rect x="5" y="6" width="3" height="1" />
            <rect x="6" y="7" width="2" height="1" />
            <rect x="5" y="8" width="3" height="1" />
            <rect x="8" y="9" width="3" height="1" />
          </svg>
          <span>DEVELOPER MODE</span>
        </button>
        <button class="mode-btn creative-mode" data-mode="creative" type="button">
          <svg class="mode-symbol" viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges" fill="currentColor">
            <g stroke="currentColor" stroke-width="1" fill="currentColor">
              <rect x="7" y="2" width="2" height="2" />
              <rect x="5" y="4" width="6" height="2" />
              <rect x="1" y="6" width="14" height="2" />
              <rect x="3" y="8" width="10" height="2" />
              <rect x="5" y="10" width="6" height="2" />
              <rect x="3" y="12" width="3" height="2" />
              <rect x="10" y="12" width="3" height="2" />
            </g>
          </svg>
          <span>CREATIVE MODE</span>
        </button>
      </div>

      <button class="skip-boot-btn" id="skip-boot-btn" type="button" aria-label="Skip boot sequence and unlock scroll">
        <svg viewBox="0 0 16 16" class="skip-icon" shape-rendering="crispEdges" aria-hidden="true">
          <rect x="2" y="2" width="12" height="12" stroke="currentColor" stroke-width="1" fill="none" />
          <rect x="5" y="5" width="6" height="6" fill="currentColor" />
        </svg>
        <span>SKIP BOOT</span>
      </button>

      <div class="scroll-prompt" id="hero-scroll-prompt">
        <div class="prompt-status-badge locked" id="scroll-lock-badge">
          <span class="badge-icon">🔒</span>
          <span class="badge-status">INITIALIZING SYSTEM...</span>
        </div>
        <div class="prompt-cta-row">
          <span class="prompt-text">SCROLL TO INITIALIZE</span>
          <span class="prompt-arrow">▼</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: ABOUT - The Creator Behind the Code and Pixels (RPG Character Select) -->
  <section id="about" class="story-section about-section">
    <div class="about-container">
      <RetroWindow title="CREATOR_PROFILE.EXE // CHARACTER SELECT" type="exe" class="creator-profile-window">
        <!-- Arcade Character Select Control Bar -->
        <div class="character-select-bar">
          <div class="select-bar-left">
            <span class="select-badge-tag"><span class="blink-dot"></span> P1 SELECT</span>
            <span class="select-instruction">CHOOSE CLASS:</span>
          </div>
          <div class="spec-tabs" role="tablist">
            <button class="spec-tab active" id="tab-spec-dev" data-spec="dev" type="button" role="tab" aria-selected="true">
              <span class="tab-indicator">▶</span>
              <span class="tab-num">01</span>
              <span class="tab-name">SYSTEMS ARCHITECT</span>
            </button>
            <button class="spec-tab" id="tab-spec-creative" data-spec="creative" type="button" role="tab" aria-selected="false">
              <span class="tab-indicator">▶</span>
              <span class="tab-num">02</span>
              <span class="tab-name">CREATIVE DEV</span>
            </button>
          </div>
          <div class="spec-nav-arrows">
            <button class="spec-nav-btn" id="spec-nav-prev" type="button" title="Previous Class" aria-label="Previous Class">◀</button>
            <button class="spec-nav-btn" id="spec-nav-next" type="button" title="Next Class" aria-label="Next Class">▶</button>
          </div>
        </div>

        <div class="creator-header">
          <div class="creator-avatar-large" id="creator-avatar">
            <svg viewBox="0 0 96 96" class="avatar-svg" shape-rendering="crispEdges" aria-hidden="true">
              <!-- Developer Mode Avatar (default) -->
              <g class="avatar-dev">
                <rect width="96" height="96" fill="#141820" />
                <rect x="28" y="12" width="40" height="8" fill="#00ff66" />
                <rect x="20" y="20" width="56" height="12" fill="#00ff66" />
                <rect x="24" y="32" width="48" height="24" fill="#f1f5f9" />
                <rect x="28" y="36" width="16" height="12" fill="#0b0d10" />
                <rect x="52" y="36" width="16" height="12" fill="#0b0d10" />
                <rect x="44" y="40" width="8" height="4" fill="#0b0d10" />
                <rect x="32" y="40" width="8" height="4" fill="#38bdf8" />
                <rect x="56" y="40" width="8" height="4" fill="#38bdf8" />
                <rect x="40" y="50" width="16" height="4" fill="#0b0d10" />
                <rect x="24" y="56" width="48" height="28" fill="#141820" stroke="#00ff66" stroke-width="3" />
                <rect x="42" y="60" width="12" height="16" fill="#38bdf8" />
                <rect x="28" y="84" width="16" height="8" fill="#00ff66" />
                <rect x="52" y="84" width="16" height="8" fill="#00ff66" />
              </g>
              <!-- Creative Mode Avatar -->
              <g class="avatar-creative" style="display:none">
                <rect width="96" height="96" fill="#ffffff" />
                <rect x="28" y="12" width="40" height="8" fill="#ff4d00" />
                <rect x="20" y="20" width="56" height="12" fill="#ff4d00" />
                <rect x="24" y="32" width="48" height="24" fill="#18181b" />
                <rect x="28" y="36" width="16" height="12" fill="#f4f1ea" />
                <rect x="52" y="36" width="16" height="12" fill="#f4f1ea" />
                <rect x="44" y="40" width="8" height="4" fill="#18181b" />
                <rect x="32" y="40" width="8" height="4" fill="#7c3aed" />
                <rect x="56" y="40" width="8" height="4" fill="#7c3aed" />
                <rect x="40" y="50" width="16" height="4" fill="#18181b" />
                <rect x="24" y="56" width="48" height="28" fill="#ffffff" stroke="#ff4d00" stroke-width="3" />
                <rect x="42" y="60" width="12" height="16" fill="#7c3aed" />
                <rect x="28" y="84" width="16" height="8" fill="#ff4d00" />
                <rect x="52" y="84" width="16" height="8" fill="#ff4d00" />
              </g>
            </svg>
          </div>
          <div class="creator-title-area">
            <div class="lvl-badge-large">LVL. 20</div>
            <h2 class="creator-name" id="creator-name">SYSTEMS ARCHITECT</h2>
            <p class="creator-class" id="creator-class">Sistem Informasi & Microservices Engineer</p>
            <p class="creator-quote" id="creator-quote">"Turning complex business logic into rock-solid 3NF architectures & high-concurrency systems."</p>
          </div>
        </div>

        <div class="creator-stats-grid" id="creator-stats-grid">
          <div class="stat-card" data-index="0">
            <span class="stat-icon icon-dev"><PixelIcons name="brain" size={18} /></span>
            <span class="stat-icon icon-creative" style="display:none"><PixelIcons name="pacman" size={18} /></span>
            <div class="stat-info">
              <span class="stat-label">SYSTEMS ANALYSIS & 3NF</span>
              <div class="stat-bar"><div class="stat-fill" data-progress="98"></div></div>
              <span class="stat-value">98/100</span>
            </div>
          </div>
          <div class="stat-card" data-index="1">
            <span class="stat-icon icon-dev"><PixelIcons name="dna" size={18} /></span>
            <span class="stat-icon icon-creative" style="display:none"><PixelIcons name="brain" size={18} /></span>
            <div class="stat-info">
              <span class="stat-label">DATABASE & ORM ARCH</span>
              <div class="stat-bar"><div class="stat-fill alt" data-progress="95"></div></div>
              <span class="stat-value">95/100</span>
            </div>
          </div>
          <div class="stat-card" data-index="2">
            <span class="stat-icon icon-dev"><PixelIcons name="trophy" size={18} /></span>
            <span class="stat-icon icon-creative" style="display:none"><PixelIcons name="terminal" size={18} /></span>
            <div class="stat-info">
              <span class="stat-label">MICROSERVICES & SSR</span>
              <div class="stat-bar"><div class="stat-fill" data-progress="90"></div></div>
              <span class="stat-value">90/100</span>
            </div>
          </div>
          <div class="stat-card" data-index="3">
            <span class="stat-icon icon-dev"><PixelIcons name="coffee" size={18} /></span>
            <span class="stat-icon icon-creative" style="display:none"><PixelIcons name="heart" size={18} /></span>
            <div class="stat-info">
              <span class="stat-label">HACKATHON SPEED-RUN</span>
              <div class="stat-bar"><div class="stat-fill warn" data-progress="98"></div></div>
              <span class="stat-value">98/100</span>
            </div>
          </div>
        </div>

        <div class="creator-perks" id="creator-perks">
          <div class="perks-group perks-dev">
            <span class="perk"><PixelIcons name="trophy" size={14} /> CODEQUEST 2024 CHAMPION</span>
            <span class="perk"><PixelIcons name="dna" size={14} /> 3NF DATABASE MASTER</span>
            <span class="perk"><PixelIcons name="coffee" size={14} /> ZERO BLUR SHADOW PHILOSOPHY</span>
          </div>
          <div class="perks-group perks-creative" style="display:none">
            <span class="perk"><PixelIcons name="pacman" size={14} /> 60FPS CANVAS PHYSICS</span>
            <span class="perk"><PixelIcons name="heart" size={14} /> PIXEL PERFECT EMOTION</span>
            <span class="perk"><PixelIcons name="star" size={14} /> JLD2ND EXPERIMENTALIST</span>
          </div>
        </div>

        <div class="creator-actions">
          <a href="/game" class="pixel-btn primary play-btn">
            <PixelIcons name="pacman" size={14} />
            <span>PLAY PIXEL RUNNER →</span>
          </a>
          <a href="/projects" class="pixel-btn view-projects-btn">
            <PixelIcons name="terminal" size={14} />
            <span>BROWSE PROJECTS</span>
          </a>
        </div>
      </RetroWindow>
    </div>
  </section>

  <!-- SECTION 3: PIXELS → IDEAS → BRAIN - Pinned Scroll Story -->
  <section id="pixels" class="story-section pin-section pixels-story-section">
    <div class="pin-wrapper" id="pixels-pin-wrapper">
      <div class="pinned-content pixels-content">
        <!-- Phase A: Single Pixel Dot -->
        <div class="story-phase phase-a" data-phase="pixels">
          <div class="single-pixel-wrapper">
            <div class="single-pixel" id="single-pixel"></div>
            <div class="pixel-sparks" id="pixel-sparks" aria-hidden="true">
              <span class="spark s-tl"></span>
              <span class="spark s-tr"></span>
              <span class="spark s-bl"></span>
              <span class="spark s-br"></span>
            </div>
          </div>
          <div class="phase-text">
            <p class="phase-line">It all starts with the pixels.</p>
            <p class="phase-line">Each one placed with purpose.</p>
          </div>
        </div>
        <!-- Phase B: Constellation Grid -->
        <div class="story-phase phase-b" id="ideas" data-phase="ideas">
          <div class="constellation-canvas" id="constellation-canvas"></div>
          <div class="phase-text">
            <p class="phase-line">This is where ideas take shape.</p>
          </div>
        </div>
        <!-- Phase C: Pixel Brain Blueprint -->
        <div class="story-phase phase-c" id="brain-section" data-phase="brain-section">
          <div class="pixel-brain-svg" id="pixel-brain-assemble"></div>
          <div class="phase-text">
            <p class="phase-line">Concept — The brain sparks the blueprint.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: DNA - 8-Bit DNA Double Helix (Pinned) -->
  <section id="dna" class="story-section pin-section dna-section">
    <div class="pin-wrapper" id="dna-pin-wrapper">
      <div class="pinned-content dna-content">
        <div class="dna-strand-container" id="dna-strand">
          <div class="dna-metric-tag" aria-hidden="true">[ HELIX // 3NF ARCH ]</div>
        </div>
        <div class="dna-text">
          <p>From this strand, everything grows…</p>
          <p>My DNA is a blueprint of <span class="dna-highlight hl-1">creativity</span>, <span class="dna-highlight hl-2">logic</span>, <span class="dna-highlight hl-3">empathy</span>, and <span class="dna-highlight hl-4">vision</span>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: EMOTION - Pixel Heart -->
  <section id="emotion" class="story-section emotion-section">
    <div class="emotion-container">
      <RetroWindow title="EMOTION.EXE" type="exe" class="emotion-window">
        <div class="emotion-content">
          <div class="pixel-heart-container" id="pixel-heart">
            <svg viewBox="0 0 64 64" shape-rendering="crispEdges" aria-hidden="true">
              <rect x="12" y="14" width="16" height="16" fill="#ff4d00" class="heart-lobe left" />
              <rect x="36" y="14" width="16" height="16" fill="#ff4d00" class="heart-lobe right" />
              <rect x="8" y="24" width="48" height="16" fill="#ff4d00" class="heart-body" />
              <rect x="14" y="40" width="36" height="12" fill="#ff4d00" class="heart-tip" />
              <rect x="22" y="52" width="20" height="6" fill="#ff4d00" class="heart-bottom" />
              <rect x="14" y="16" width="6" height="4" fill="#ffaaaa" class="heart-shine" />
            </svg>
          </div>
          <div class="emotion-text">
            <p class="emotion-headline">More than just function.</p>
            <p class="emotion-sub">Design evokes <span class="emotion-highlight">emotion</span>.</p>
          </div>
          <div class="ecg-monitor" aria-hidden="true">
            <svg viewBox="0 0 200 36" class="ecg-svg" shape-rendering="crispEdges">
              <polyline points="0,18 45,18 52,18 58,4 66,32 72,12 78,22 84,18 135,18 142,18 148,4 156,32 162,12 168,22 174,18 200,18" fill="none" stroke="#ff4d00" stroke-width="2" class="ecg-line" />
            </svg>
            <div class="ecg-label"><span class="ecg-live-dot"></span> 82 BPM // SYNAPSE EMOTION ONLINE</div>
          </div>
        </div>
      </RetroWindow>
    </div>
  </section>

  <!-- SECTION 6: BEAUTY - Pixel Eye -->
  <section id="beauty" class="story-section beauty-section">
    <div class="beauty-container">
      <RetroWindow title="BEAUTY.SYS" type="sys" class="beauty-window">
        <div class="beauty-content">
          <div class="pixel-eye-container" id="pixel-eye">
            <div class="eye-hud-bracket top-left"></div>
            <div class="eye-hud-bracket top-right"></div>
            <div class="eye-hud-bracket bottom-left"></div>
            <div class="eye-hud-bracket bottom-right"></div>
            <svg viewBox="0 0 80 40" shape-rendering="crispEdges" aria-hidden="true">
              <!-- Eye white -->
              <rect x="4" y="4" width="72" height="32" fill="var(--bg-elevated)" class="eye-white" />
              <!-- Iris -->
              <rect x="28" y="10" width="24" height="20" fill="var(--accent-primary)" class="eye-iris" id="eye-iris" />
              <!-- Pupil (moves with scroll) -->
              <rect x="36" y="14" width="8" height="12" fill="var(--text-primary)" class="eye-pupil" id="eye-pupil" />
              <!-- Shine -->
              <rect x="30" y="12" width="4" height="4" fill="var(--accent-secondary)" class="eye-shine" />
              <!-- Eyelashes top -->
              <rect x="8" y="4" width="2" height="2" fill="var(--border-color)" class="lash" />
              <rect x="14" y="4" width="2" height="2" fill="var(--border-color)" class="lash" />
              <rect x="20" y="4" width="2" height="2" fill="var(--border-color)" class="lash" />
              <rect x="58" y="4" width="2" height="2" fill="var(--border-color)" class="lash" />
              <rect x="64" y="4" width="2" height="2" fill="var(--border-color)" class="lash" />
              <rect x="70" y="4" width="2" height="2" fill="var(--border-color)" class="lash" />
            </svg>
            <div class="eye-target-badge">SCANNING // GOLDEN RATIO: 1.618</div>
          </div>
          <div class="beauty-text">
            <p class="beauty-headline">Form follows function,</p>
            <p class="beauty-sub">but <span class="beauty-highlight">beauty leads</span>.</p>
          </div>
        </div>
      </RetroWindow>
    </div>
  </section>

  <!-- SECTION 7: HANDS - Building Hands (Pinned Scrub) -->
  <section id="hands" class="story-section pin-section hands-section">
    <div class="pin-wrapper" id="hands-pin-wrapper">
      <div class="pinned-content hands-content">
        <div class="hands-stage">
          <div class="hand left-hand" id="left-hand">
            <svg viewBox="0 0 60 60" shape-rendering="crispEdges" aria-hidden="true">
              <rect x="0" y="20" width="16" height="32" fill="#f1f5f9" class="hand-arm" />
              <rect x="16" y="12" width="28" height="40" fill="#f1f5f9" class="hand-palm" />
              <rect x="16" y="12" width="8" height="16" fill="#f1f5f9" class="finger" />
              <rect x="24" y="12" width="8" height="20" fill="#f1f5f9" class="finger" />
              <rect x="32" y="12" width="8" height="18" fill="#f1f5f9" class="finger" />
              <rect x="40" y="16" width="4" height="14" fill="#f1f5f9" class="finger pinky" />
            </svg>
          </div>
          <div class="energy-spark-bridge" id="energy-spark-bridge" aria-hidden="true">
            <svg viewBox="0 0 100 20" shape-rendering="crispEdges" class="spark-svg">
              <rect x="10" y="9" width="14" height="2" fill="var(--accent-primary)" class="spark-bit" />
              <rect x="28" y="6" width="18" height="3" fill="var(--accent-secondary)" class="spark-bit" />
              <rect x="50" y="10" width="16" height="3" fill="#ffde00" class="spark-bit" />
              <rect x="70" y="7" width="20" height="2" fill="var(--accent-primary)" class="spark-bit" />
            </svg>
          </div>
          <div class="hand right-hand" id="right-hand">
            <svg viewBox="0 0 60 60" shape-rendering="crispEdges" aria-hidden="true">
              <rect x="44" y="20" width="16" height="32" fill="#f1f5f9" class="hand-arm" />
              <rect x="16" y="12" width="28" height="40" fill="#f1f5f9" class="hand-palm" />
