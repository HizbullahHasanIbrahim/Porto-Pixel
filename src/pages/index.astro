    font-size: 0.65rem;
    padding: 0.75rem 1.25rem;
    box-shadow: var(--pixel-shadow);
    cursor: pointer;
    transition: all 0.15s;
  }

  .mode-btn:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--border-color);
  }

  .mode-btn.active {
    background: var(--accent-primary);
    color: #0b0d10;
    border-color: var(--accent-primary);
  }

  .mode-btn.creative-mode.active {
    background: var(--accent-primary);
    color: #0b0d10;
  }

  .mode-particle { image-rendering: pixelated; }

  .skip-boot-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: 2px solid var(--border-color);
    color: var(--accent-primary);
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.55rem;
    padding: 0.5rem 1rem;
    box-shadow: var(--pixel-shadow);
    cursor: pointer;
    transition: all 0.15s;
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .skip-boot-btn:hover {
    background: var(--accent-primary);
    color: #0b0d10;
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--border-color);
  }

  .skip-icon {
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
    fill: currentColor;
  }

  .scroll-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    user-select: none;
    transition: transform 0.2s ease;
  }

  .prompt-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.55rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border-color);
    box-shadow: 2px 2px 0 var(--border-color);
    transition: all 0.3s ease;
  }

  .prompt-status-badge.locked {
    background: rgba(255, 77, 0, 0.15);
    border-color: #ff4d00;
    color: #ff4d00;
    box-shadow: 2px 2px 0 #ff4d00;
  }

  .prompt-status-badge.locked.shake {
    animation: badgeShake 0.35s ease;
  }

  @keyframes badgeShake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-5px); }
    40%, 80% { transform: translateX(5px); }
  }

  .prompt-status-badge.unlocked {
    background: rgba(0, 255, 102, 0.15);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    box-shadow: 0 0 12px rgba(0, 255, 102, 0.4), 2px 2px 0 var(--border-color);
    animation: unlockedGlow 2s infinite alternate;
  }

  @keyframes unlockedGlow {
    0% { box-shadow: 0 0 4px var(--accent-primary), 2px 2px 0 var(--border-color); }
    100% { box-shadow: 0 0 16px var(--accent-primary), 3px 3px 0 var(--border-color); }
  }

  .prompt-cta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prompt-text {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.6rem;
    color: var(--text-muted);
  }

  .prompt-arrow {
    color: var(--accent-primary);
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }

  .prompt-arrow.bouncing {
    animation: bounce 1.2s infinite;
  }

  .scroll-prompt:hover .prompt-status-badge.unlocked {
    transform: translateY(-2px);
    box-shadow: 0 0 18px var(--accent-primary), 3px 3px 0 var(--border-color);
  }

  /* ============================================
     ABOUT SECTION - RPG Character Select
     ============================================ */
  .about-section { padding: 6rem 1.5rem; }
  .about-container { max-width: 1000px; margin: 0 auto; width: 100%; }

  .creator-profile-window { width: 100%; }

  /* Arcade Character Select Bar */
  .character-select-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    background: var(--bg-primary);
    border: 2px solid var(--border-color);
    box-shadow: var(--pixel-shadow);
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
  }

  .select-bar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .select-badge-tag {
    background: var(--accent-primary);
    color: var(--bg-primary);
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.65rem;
    padding: 0.35rem 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    box-shadow: 2px 2px 0px var(--text-primary);
  }

  .blink-dot {
    width: 6px;
    height: 6px;
    background: var(--bg-primary);
    display: inline-block;
    animation: blink-dot-anim 1s steps(1) infinite;
  }

  @keyframes blink-dot-anim {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .select-instruction {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .spec-tabs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .spec-tab {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.65rem;
    padding: 0.5rem 0.85rem;
    background: var(--bg-elevated);
    border: 2px solid var(--border-color);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    transition: transform 0.1s ease, background 0.15s ease, color 0.15s ease;
  }

  .spec-tab:hover:not(.active) {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    transform: translate(-1px, -1px);
  }

  .spec-tab.active {
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-color: var(--text-primary);
    box-shadow: 3px 3px 0px var(--text-primary);
  }

  .spec-tab .tab-indicator {
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .spec-tab.active .tab-indicator {
    opacity: 1;
    transform: translateX(0);
  }

  .spec-tab .tab-num {
    opacity: 0.75;
    font-size: 0.6rem;
  }

  .spec-nav-arrows {
    display: flex;
    gap: 0.35rem;
  }

  .spec-nav-btn {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated);
    border: 2px solid var(--border-color);
    color: var(--text-primary);
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.7rem;
    cursor: pointer;
    box-shadow: 2px 2px 0px var(--border-color);
    transition: transform 0.05s ease, background 0.15s ease, color 0.15s ease;
  }

  .spec-nav-btn:hover {
    background: var(--accent-primary);
    color: var(--bg-primary);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px var(--border-color);
  }

  .spec-nav-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--border-color);
  }

  .creator-header {
    display: flex; gap: 2rem; align-items: flex-start;
    margin-bottom: 2rem; flex-wrap: wrap;
  }

  .creator-avatar-large {
    flex-shrink: 0;
    position: relative;
    border: 3px solid var(--border-color);
    box-shadow: var(--pixel-shadow);
    background: var(--bg-primary);
    padding: 0.35rem;
  }

  .avatar-svg { width: 140px; height: 140px; image-rendering: pixelated; }

  .creator-title-area { flex: 1; min-width: 200px; }
  .lvl-badge-large {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 1.5rem; color: var(--accent-primary);
    margin-bottom: 0.5rem;
  }
  .creator-name {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    color: var(--text-primary); margin-bottom: 0.25rem;
  }
  .creator-class {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.9rem; color: var(--text-muted);
  }

  .creator-quote {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.85rem;
    color: var(--accent-secondary);
    margin-top: 0.6rem;
    border-left: 3px solid var(--accent-secondary);
    padding-left: 0.75rem;
    font-style: italic;
    line-height: 1.5;
  }

  .creator-stats-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .stat-card {
    display: flex; align-items: center; gap: 1rem;
    background: var(--bg-primary); border: 2px solid var(--border-color);
    box-shadow: 2px 2px 0px var(--border-color);
    padding: 1rem;
  }

  .stat-icon {
    color: var(--accent-primary);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
  }
  .stat-info { flex: 1; display: flex; flex-direction: column; gap: 0.25rem; }
  .stat-label {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.6rem; color: var(--text-muted);
  }
  .stat-bar {
    height: 10px; background: var(--bg-elevated); border: 1px solid var(--border-color);
    overflow: hidden;
  }
  .stat-fill {
    height: 100%; width: 0%; background: var(--accent-primary);
    transition: width 0.3s;
  }
  .stat-fill.alt { background: var(--accent-secondary); }
  .stat-fill.warn { background: #ff4d00; }
  .stat-value {
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.65rem; color: var(--accent-primary); text-align: right;
  }

  .creator-perks {
    margin-bottom: 1.5rem;
  }

  .perks-group {
    display: flex; gap: 1rem; flex-wrap: wrap;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.7rem; color: var(--text-muted);
  }

  .perk {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    box-shadow: 2px 2px 0px var(--border-color);
  }

  .creator-actions {
    display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;
  }

  .creator-actions .pixel-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.75rem 1.25rem;
  }

  .play-btn { width: 100%; max-width: 300px; justify-content: center; }
  .view-projects-btn { width: 100%; max-width: 300px; justify-content: center; }

  /* ============================================
     PIXELS → IDEAS → BRAIN STORY
     ============================================ */
  .pixels-story-section { overflow: visible; }

  .pixels-content {
    position: relative;
    height: 100vh;
    min-height: 560px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .story-phase {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    width: min(100%, 800px);
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: none;
  }

  .story-phase.phase-a { opacity: 1; }

  .phase-text { max-width: 600px; }
  .phase-line {
    font-family: var(--font-heading, 'Syne', sans-serif);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700; line-height: 1.3;
    color: var(--text-primary); margin-bottom: 0.5rem;
  }

  /* Phase A: Single Pixel */
  .single-pixel-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .single-pixel {
    width: 24px; height: 24px;
    background: var(--accent-primary);
    box-shadow: 0 0 0 var(--accent-primary);
    image-rendering: pixelated;
  }

  .pixel-sparks {
    position: absolute;
    inset: -20px;
    pointer-events: none;
  }

  .spark {
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-primary);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  /* Phase B: Constellation */
  .constellation-canvas {
    position: relative;
    width: min(72vw, 680px);
    height: min(62vh, 560px);
    min-height: 300px;
    background: radial-gradient(ellipse at center, var(--bg-elevated) 0%, var(--bg-primary) 100%);
    border: 2px solid var(--border-color);
    box-shadow: var(--pixel-shadow);
    overflow: hidden;
  }

  .constellation-hud {
    position: absolute;
    top: 8px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.55rem;
    color: var(--accent-primary);
    opacity: 0.85;
    pointer-events: none;
    z-index: 3;
    border-bottom: 1px dashed var(--border-color);
    padding-bottom: 4px;
  }

  .constellation-svg-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .constellation-line {
    stroke-linecap: square;
    filter: drop-shadow(0 0 2px var(--accent-secondary));
  }

  .constellation-dot { image-rendering: pixelated; }

  /* Phase C: Pixel Brain */
  .pixel-brain-svg {
    position: relative;
    width: 300px;
    height: 250px;
    overflow: hidden;
  }
  .brain-scanline {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-primary);
    box-shadow: 0 0 12px var(--accent-primary);
    opacity: 0;
    pointer-events: none;
    z-index: 5;
  }
  .brain-svg { width: 100%; height: 100%; }
  .brain-part { transform-origin: center center; }

  /* ============================================
     DNA SECTION
     ============================================ */
  .dna-content { display: flex; flex-direction: row; align-items: center; height: 100vh; justify-content: center; gap: clamp(2rem, 8vw, 8rem); }
  .dna-strand-container { width: 180px; height: min(72vh, 680px); position: relative; flex: 0 0 auto; }
  .dna-metric-tag {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.5rem;
    color: var(--accent-secondary);
    white-space: nowrap;
    opacity: 0.75;
    letter-spacing: 0.5px;
  }
  .dna-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .dna-pair { transform-origin: 50px 50px; }
  .dna-text {
    max-width: 440px;
    text-align: left;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-primary);
  }
  .dna-highlight {
    color: var(--text-muted);
    font-weight: 700;
    padding: 0 4px;
    border-bottom: 2px solid transparent;
    transition: all 0.3s ease;
  }
  .dna-highlight.active.hl-1 {
    color: #ff4d00;
    border-bottom-color: #ff4d00;
    text-shadow: 0 0 8px rgba(255, 77, 0, 0.6);
  }
  .dna-highlight.active.hl-2 {
    color: var(--accent-primary);
    border-bottom-color: var(--accent-primary);
    text-shadow: 0 0 8px rgba(0, 255, 102, 0.6);
  }
  .dna-highlight.active.hl-3 {
    color: #ff3366;
    border-bottom-color: #ff3366;
    text-shadow: 0 0 8px rgba(255, 51, 102, 0.6);
  }
  .dna-highlight.active.hl-4 {
    color: var(--accent-secondary);
    border-bottom-color: var(--accent-secondary);
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
  }

  /* ============================================
     EMOTION - HEART & ECG
     ============================================ */
  .emotion-section { padding: 6rem 1.5rem; }
  .emotion-container { max-width: 600px; margin: 0 auto; width: 100%; }
  .emotion-window { width: 100%; }
  .emotion-content { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; text-align: center; padding: 2rem 1rem; }
  .pixel-heart-container { width: 180px; height: 180px; }
  .pixel-heart-container svg { width: 100%; height: 100%; transform-origin: center center; }
  .emotion-text { max-width: 500px; }
  .emotion-headline {
    font-family: var(--font-heading, 'Syne', sans-serif);
    font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 700;
    color: var(--text-primary); margin-bottom: 0.5rem;
  }
  .emotion-sub {
    font-family: var(--font-body, 'Space Grotesk', sans-serif);
    font-size: clamp(1rem, 2vw, 1.2rem); color: var(--text-muted);
  }
  .emotion-highlight { color: #ff4d00; font-weight: 800; }

  .ecg-monitor {
    width: 100%;
    max-width: 380px;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    padding: 0.75rem 1rem;
    box-shadow: var(--pixel-shadow);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ecg-svg {
    width: 100%;
    height: 36px;
    overflow: visible;
  }
  .ecg-line {
    stroke-dasharray: 260;
    stroke-dashoffset: 0;
    filter: drop-shadow(0 0 4px #ff4d00);
  }
  .ecg-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.55rem;
    color: #ff4d00;
    letter-spacing: 0.5px;
  }
  .ecg-live-dot {
    width: 6px;
    height: 6px;
    background: #ff4d00;
    border-radius: 50%;
    animation: pulse 1s infinite;
  }

  /* ============================================
     BEAUTY - EYE & CYBER HUD
     ============================================ */
  .beauty-section { padding: 6rem 1.5rem; }
  .beauty-container { max-width: 600px; margin: 0 auto; width: 100%; }
  .beauty-window { width: 100%; }
  .beauty-content { display: flex; flex-direction: column; align-items: center; gap: 2rem; text-align: center; padding: 2rem 1rem; }
  .pixel-eye-container {
    position: relative;
    width: 240px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pixel-eye-container svg { width: 100%; height: 100%; }
  .eye-hud-bracket {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: var(--accent-secondary);
    border-style: solid;
    pointer-events: none;
  }
  .eye-hud-bracket.top-left {
    top: -8px; left: -8px;
    border-width: 2px 0 0 2px;
  }
  .eye-hud-bracket.top-right {
    top: -8px; right: -8px;
    border-width: 2px 2px 0 0;
  }
  .eye-hud-bracket.bottom-left {
    bottom: -8px; left: -8px;
    border-width: 0 0 2px 2px;
  }
  .eye-hud-bracket.bottom-right {
    bottom: -8px; right: -8px;
    border-width: 0 2px 2px 0;
  }
  .eye-target-badge {
    position: absolute;
    bottom: -28px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-pixel, 'Press Start 2P', monospace);
    font-size: 0.55rem;
    color: var(--accent-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--accent-secondary);
    padding: 3px 8px;
    box-shadow: 2px 2px 0 var(--border-color);
    opacity: 0;
  }
  .beauty-text { max-width: 500px; }
  .beauty-headline {
    font-family: var(--font-heading, 'Syne', sans-serif);
    font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 700;
    color: var(--text-primary); margin-bottom: 0.5rem;
  }
  .beauty-sub {
    font-family: var(--font-body, 'Space Grotesk', sans-serif);
    font-size: clamp(1rem, 2vw, 1.2rem); color: var(--text-muted);
  }
  .beauty-highlight { color: var(--accent-secondary); font-weight: 800; }

  /* ============================================
     HANDS SECTION & SPARK BRIDGE
     ============================================ */
  .hands-content { display: flex; flex-direction: column; align-items: center; height: 100vh; justify-content: center; gap: 2rem; }
  .hands-stage { display: flex; align-items: center; justify-content: center; gap: 2rem; height: 60vh; position: relative; }
  .hand { flex-shrink: 0; }
  .hand svg { width: 180px; height: 180px; image-rendering: pixelated; }
  .left-hand { transform: scaleX(-1); }
  .energy-spark-bridge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140px;
    height: 30px;
    pointer-events: none;
    z-index: 8;
    opacity: 0;
  }
  .spark-svg { width: 100%; height: 100%; }
  .spark-bit {
    transform-origin: center center;
    filter: drop-shadow(0 0 4px var(--accent-primary));
  }
  .center-crystal { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10; }
  .center-crystal svg { width: 120px; height: 120px; image-rendering: pixelated; }
  .crystal-glow-ring {
    position: absolute;
    inset: -14px;
    border: 2px dashed var(--accent-primary);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    animation: rotateGlow 6s linear infinite;
  }
  @keyframes rotateGlow {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .hands-text { text-align: center; max-width: 600px; }
