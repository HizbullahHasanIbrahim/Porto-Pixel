        <rect x="80" y="15" width="60" height="45" fill="var(--bg-elevated)" />
        <rect x="140" y="25" width="90" height="35" fill="var(--bg-elevated)" />
        <rect x="230" y="10" width="70" height="50" fill="var(--bg-elevated)" />
        <rect x="300" y="35" width="80" height="25" fill="var(--bg-elevated)" />
        <rect x="380" y="20" width="60" height="40" fill="var(--bg-elevated)" />
        <rect x="440" y="5" width="50" height="55" fill="var(--bg-elevated)" />
        <rect x="490" y="25" width="80" height="35" fill="var(--bg-elevated)" />
        <rect x="570" y="15" width="70" height="45" fill="var(--bg-elevated)" />
        <rect x="640" y="30" width="90" height="30" fill="var(--bg-elevated)" />
        <rect x="730" y="10" width="70" height="50" fill="var(--bg-elevated)" />
      </svg>
    </div>

    <div class="footer-container">
      <div class="footer-top">
        <div class="footer-brand">
          <h3 class="footer-logo">HZB.DEV</h3>
          <p class="footer-copy">Hizbullah Hasan Ibrahim &copy; 2024. All rights reserved.</p>
        </div>
        <div class="footer-nav">
          <div class="footer-nav-group">
            <a href="/" class="pixel-btn primary" title="Home">
              <PixelIcons name="home" size={14} />
              <span>Home</span>
            </a>
            <a href="/projects" class="pixel-btn primary" title="Projects">
              <PixelIcons name="claw" size={14} />
              <span>Projects</span>
            </a>
            <a href="/game" class="pixel-btn primary" title="Game">
              <PixelIcons name="pacman" size={14} />
              <span>Game</span>
            </a>
            <a href="#contact" class="pixel-btn primary" title="Contact">
              <PixelIcons name="terminal" size={14} />
              <span>Contact</span>
            </a>
