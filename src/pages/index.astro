      );

      tl.from('.hands-text', { opacity: 0, y: 20, duration: 0.35 }, 0.65);
    });

    mm.add('(max-width: 768px)', () => {
      gsap.from('.hand', { scrollTrigger: { trigger: '#hands', start: 'top 80%' }, opacity: 0, x: (i) => i === 0 ? -100 : 100, duration: 1, stagger: 0.2 });
      gsap.from('#energy-spark-bridge', { scrollTrigger: { trigger: '#hands', start: 'top 65%' }, opacity: 0, scale: 0.5, duration: 0.6 });
      gsap.from('#center-crystal', { scrollTrigger: { trigger: '#hands', start: 'top 50%' }, scale: 0, opacity: 0, duration: 1, delay: 0.3, ease: 'back.out(1.7)' });
      gsap.from('.hands-text', { scrollTrigger: { trigger: '#hands', start: 'top 50%' }, opacity: 0, y: 20, duration: 0.8, delay: 0.6 });
    });
  }

  // ============================================
  // 8. WINDOWS - 10 WINDOW CASCADE (PINNED SCRUB)
  // ============================================
  function initWindowsSection() {
    const mm = gsap.matchMedia();

    mm.add('(min-width: 769px)', () => {
      // Master Timeline for 10 Windows Cascade (Compressed to +=180% to eliminate dead scroll time)
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#windows',
          start: 'top top',
          end: '+=180%',
          pin: '#windows-pin-wrapper',
          pinSpacing: true,
          scrub: 1,
          anticipatePin: 1,
        },
      });

      const alertWindows = gsap.utils.toArray<HTMLElement>('.cascade-win:not(.win-10)');
      tl.from(alertWindows, {
        y: 120,
        x: (i) => (i % 2 === 0 ? -50 : 50),
        rotation: (i) => ((i % 3) - 1) * 2.5,
        scale: 0.8,
        opacity: 0,
        ease: 'power1.out',
        duration: 0.5,
        stagger: 0.08,
      }, 0);

      // Main portfolio window (10th) takes center stage
      tl.from('.win-10', {
        scale: 0.4,
        opacity: 0,
        y: 50,
        ease: 'back.out(1.7)',
        duration: 0.45,
      }, 0.85);
    });

    mm.add('(max-width: 768px)', () => {
      // Mobile: simple vertical stack reveal
      gsap.from('.cascade-win', {
        scrollTrigger: { trigger: '#windows', start: 'top 80%' },
        opacity: 0,
        y: 40,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power2.out',
      });
    });
  }

  // ============================================
  // 9. TETRIS - BLOCK STACK CTA (PINNED SCRUB)
  // ============================================
  function buildTetrisDOM() {
    const board = document.getElementById('tetris-board');
    const nextPieceElement = document.getElementById('next-piece');
    if (!board || board.dataset.initialized === 'true') return;
    board.dataset.initialized = 'true';

    if (nextPieceElement) {
      nextPieceElement.innerHTML = `
        <div class="tetromino-preview" style="position:relative; width:64px; height:64px; margin:0 auto; border: 2px solid var(--border-color); background: var(--bg-elevated); box-shadow: var(--pixel-shadow);">
          <div style="position:absolute; width:14px; height:14px; left:14px; top:18px; background:#7c3aed; border:1px solid var(--border-color);"></div>
          <div style="position:absolute; width:14px; height:14px; left:28px; top:18px; background:#7c3aed; border:1px solid var(--border-color);"></div>
          <div style="position:absolute; width:14px; height:14px; left:42px; top:18px; background:#7c3aed; border:1px solid var(--border-color);"></div>
          <div style="position:absolute; width:14px; height:14px; left:28px; top:32px; background:#7c3aed; border:1px solid var(--border-color);"></div>
        </div>
      `;
    }

    const tetrominoes = [
      { type: 'I', blocks: [[0,0],[0,1],[0,2],[0,3]], color: 'var(--accent-secondary)' },
      { type: 'L', blocks: [[0,0],[0,1],[0,2],[1,2]], color: '#ff4d00' },
      { type: 'T', blocks: [[0,0],[1,0],[2,0],[1,1]], color: '#7c3aed' },
      { type: 'O', blocks: [[0,0],[1,0],[0,1],[1,1]], color: '#ffde00' },
      { type: 'Z', blocks: [[0,0],[1,0],[1,1],[2,1]], color: '#00ff66' },
      { type: 'S', blocks: [[1,0],[2,0],[0,1],[1,1]], color: '#ff4d00' },
      { type: 'J', blocks: [[1,0],[1,1],[1,2],[0,2]], color: '#38bdf8' },
    ];

    let currentY = -4;
    tetrominoes.forEach((t) => {
      const piece = document.createElement('div');
      piece.className = `tetromino tetromino-${t.type}`;
      piece.dataset.initialY = String(currentY * 30);
      piece.style.cssText = `
        position: absolute;
        top: ${currentY * 30}px;
        left: 50%;
        transform: translateX(-50%);
        pointer-events: none;
      `;

      t.blocks.forEach(([bx, by]) => {
        const block = document.createElement('div');
        block.style.cssText = `
          position: absolute;
          width: 28px; height: 28px;
          left: ${bx * 30}px; top: ${by * 30}px;
          background: ${t.color};
          border: 2px solid var(--border-color);
          box-sizing: border-box;
        `;
        piece.appendChild(block);
      });

      board.appendChild(piece);
      currentY += 4;
    });
  }

  function initTetrisSection() {
    buildTetrisDOM();

    const mm = gsap.matchMedia();

    mm.add('(min-width: 769px)', () => {
      // Master Timeline for Tetris Section (Compressed to +=120%)
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#tetris',
          start: 'top top',
          end: '+=120%',
          pin: '#tetris-pin-wrapper',
          pinSpacing: true,
          scrub: 1,
          anticipatePin: 1,
        },
      });

      const pieces = document.querySelectorAll<HTMLElement>('#tetris-board .tetromino');
      pieces.forEach((piece, i) => {
        const initialY = parseFloat(piece.dataset.initialY || '0');
        const currentYIndex = initialY / 30;
        gsap.set(piece, { y: 0 });
        tl.to(piece, {
          y: (18 - currentYIndex) * 30,
          ease: 'none',
          duration: 0.35,
        }, i * 0.09);
      });

      // Victory Line Clear Flash, Board Shake & Banner
      tl.to('#tetris-flash', { opacity: 0.9, duration: 0.08 }, 0.68)
        .to('#tetris-flash', { opacity: 0, duration: 0.15 }, 0.76)
        .to('#tetris-board', { x: 5, duration: 0.03 }, 0.69)
        .to('#tetris-board', { x: -6, duration: 0.04 }, 0.72)
        .to('#tetris-board', { x: 4, duration: 0.03 }, 0.76)
        .to('#tetris-board', { x: 0, duration: 0.03 }, 0.79)
        .to('#tetris-clear-banner', { opacity: 1, scale: 1, duration: 0.25, ease: 'back.out(1.7)' }, 0.72);

      // Fade in CTA text
      tl.from('.tetris-cta-text', {
        opacity: 0,
        y: 25,
        duration: 0.35,
      }, 0.8);
    });

    mm.add('(max-width: 768px)', () => {
      const pieces = document.querySelectorAll<HTMLElement>('#tetris-board .tetromino');
      pieces.forEach((piece, i) => {
        gsap.set(piece, { y: 220 + (i % 4) * 28 });
      });

      gsap.from('#tetris-board', { scrollTrigger: { trigger: '#tetris', start: 'top 85%' }, opacity: 0, y: 25, duration: 0.8 });
      gsap.to('#tetris-clear-banner', {
        scrollTrigger: { trigger: '#tetris', start: 'top 60%' },
        opacity: 1,
        scale: 1,
        duration: 0.6,
        ease: 'back.out(1.7)'
      });
      gsap.from('.tetris-cta-text', { scrollTrigger: { trigger: '#tetris', start: 'top 85%' }, opacity: 0, y: 20, duration: 0.8, delay: 0.2 });
    });
  }

  // ============================================
  // 10. WORLD - PIXEL GLOBE ROTATION & RADAR PINGS
  // ============================================
  function initWorldSection() {
    const globeSvg = document.querySelector<SVGSVGElement>('.globe-svg');
    if (globeSvg) {
      // Rotation on scroll
      ScrollTrigger.create({
        trigger: '#world',
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1,
        onUpdate: (self) => {
          const rotation = self.progress * 30; // 30 deg total
          globeSvg.style.transform = `rotate(${rotation}deg)`;
        },
      });

      // Continent pulse
      gsap.to('.continent', {
        scrollTrigger: { trigger: '#world', start: 'top 80%', end: 'bottom 20%', scrub: 1 },
        scale: 1.05,
        transformOrigin: 'center center',
        stagger: 0.1,
      });

      // Radar ping dots pulsing
      gsap.to('.globe-ping-dot', {
        scale: 1.8,
        opacity: 0.3,
        transformOrigin: 'center center',
        repeat: -1,
        yoyo: true,
        duration: 1.2,
        stagger: 0.3,
      });

      // Connection lines draw
      gsap.from('.conn-line', {
        scrollTrigger: { trigger: '#world', start: 'top 70%', end: 'bottom 30%', scrub: 1 },
        strokeDasharray: '0, 200',
        strokeDashoffset: 0,
        opacity: 0.6,
      });
    }

    gsap.from('.world-content', {
      scrollTrigger: { trigger: '#world', start: 'top 75%' },
      opacity: 0,
      y: 30,
      duration: 1,
      ease: 'power2.out',
    });
  }

  // ============================================
  // 11. MODE TOGGLE - Real-time Theme Switch
  // ============================================
  function initModeToggle() {
    const devBtn = document.querySelector<HTMLButtonElement>('.mode-btn.dev-mode');
    const creativeBtn = document.querySelector<HTMLButtonElement>('.mode-btn.creative-mode');
    const avatarDev = document.querySelector<HTMLElement>('.avatar-dev');
    const avatarCreative = document.querySelector<HTMLElement>('.avatar-creative');

    function setMode(mode: string, dispatch = true) {
      document.documentElement.setAttribute('data-mode', mode);
      localStorage.setItem('hzb-theme-mode', mode);

      if (devBtn && creativeBtn) {
        devBtn.classList.toggle('active', mode === 'developer');
        creativeBtn.classList.toggle('active', mode === 'creative');
      }

      if (avatarDev && avatarCreative) {
        if (mode === 'creative') {
          avatarDev.style.display = 'none';
          avatarCreative.style.display = 'block';
        } else {
          avatarDev.style.display = 'block';
          avatarCreative.style.display = 'none';
        }
      }

      // Hero character toggle
      const heroDev = document.querySelector<HTMLElement>('.char-dev');
      const heroCreative = document.querySelector<HTMLElement>('.char-creative');
      if (heroDev && heroCreative) {
        if (mode === 'creative') {
          heroDev.style.display = 'none';
          heroCreative.style.display = 'block';
        } else {
          heroDev.style.display = 'block';
          heroCreative.style.display = 'none';
        }
      }

      // Particle burst effect
      createModeParticles(mode);

      // Synchronize with Header navbar and other listeners
      if (dispatch) {
        window.dispatchEvent(new CustomEvent('hzb-theme-change', { detail: { mode } }));
      }
    }

    devBtn?.addEventListener('click', () => setMode('developer'));
    creativeBtn?.addEventListener('click', () => setMode('creative'));

    // Listen to mode toggle from floating navbar dock (Header.astro)
    window.addEventListener('hzb-theme-change', ((e: Event) => {
      const customEvent = e as CustomEvent<{ mode?: string }>;
      const mode = customEvent.detail?.mode;
      if (mode && mode !== document.documentElement.getAttribute('data-mode')) {
        setMode(mode, false);
      }
    }) as EventListener);

    // Initialize from localStorage
    const savedMode = localStorage.getItem('hzb-theme-mode');
    if (savedMode) setMode(savedMode, false);
  }

  function createModeParticles(mode: string) {
    const colors = mode === 'creative' ? ['#ff4d00', '#7c3aed', '#ffde00'] : ['#00ff66', '#38bdf8', '#ffde00'];
    const container = document.querySelector('.hero-avatar-box');
    if (!container) return;

    for (let i = 0; i < 12; i++) {
      const particle = document.createElement('div');
      particle.className = 'mode-particle';
      const color = colors[Math.floor(Math.random() * colors.length)];
      const angle = (Math.PI * 2 * i) / 12;
      const distance = 60 + Math.random() * 40;
      const x = Math.cos(angle) * distance;
      const y = Math.sin(angle) * distance;

      particle.style.cssText = `
        position: absolute;
        width: 6px; height: 6px;
        background: ${color};
        left: 50%; top: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
        z-index: 10;
      `;
      container.appendChild(particle);

      gsap.to(particle, {
        x,
        y,
        opacity: 0,
        scale: 0,
        duration: 0.8,
        ease: 'power2.out',
        onComplete: () => particle.remove(),
      });
    }
  }

  // ============================================
  // 12. GREETING SCRAMBLE (Hero Badge)
  // ============================================
  function initGreetingScramble() {
    const badgeText = document.querySelector<HTMLElement>('.badge-text')!;
    if (!badgeText) return;

    const greetings = [
      'HELLO // WORLD READY',
      'HALO // SISTEM SIAP',
      'こんにちは // システム準備完了',
      'BONJOUR // SYSTÈME PRÊT',
      'HOLA // SISTEMA LISTO',
    ];

    let index = 0;
    function scramble() {
      const text = greetings[index];
      let chars = text.split('');
      let iterations = 0;
      const interval = setInterval(() => {
        badgeText.textContent = chars.map((_, i) => {
          if (i < iterations) return text[i];
          return '!@#$%^&*()_+-=[]{}|;:,.<>?'.charAt(Math.floor(Math.random() * 30));
        }).join('');
        iterations += 2;
        if (iterations >= text.length) {
          clearInterval(interval);
          badgeText.textContent = text;
        }
      }, 30);
    }

    scramble();
    setInterval(() => {
      index = (index + 1) % greetings.length;
      scramble();
    }, 4000);
  }

  // ============================================
  // 13. CONTACT MODAL TRIGGER
  // ============================================
  function initContactTriggers() {
    document.querySelectorAll('.contact-trigger, #footer-contact-trigger').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const dialog = document.getElementById('contact-dialog') as HTMLDialogElement | null;
        dialog?.showModal();
      });
    });
  }

  // ============================================
  // 14. WINDOW 10 [ NO ] BUTTON RETRO EASTER EGG
  // ============================================
  function initWindowNoButton() {
    const noBtn = document.getElementById('win-no-btn') as HTMLButtonElement | null;
    const winMsg = document.getElementById('portfolio-win-msg');
    const win10 = document.querySelector('.win-10') as HTMLElement | null;

    if (!noBtn || !winMsg || !win10) return;

    let clicks = 0;
    const messages = [
      'ERROR 403: Curiosity overflow! Are you really sure?',
      'ACCESS DENIED: Great projects await your inspection!',
      'SYSTEM OVERRIDE: Opening anyway in 3... 2... 1...',
    ];

    noBtn.addEventListener('click', () => {
      clicks++;

      // Retro screen shake via GSAP
      gsap.timeline()
        .to(win10, { x: '+=10', duration: 0.05 })
        .to(win10, { x: '-=20', duration: 0.05 })
        .to(win10, { x: '+=15', duration: 0.05 })
        .to(win10, { x: '-=10', duration: 0.05 })
        .to(win10, { x: '+=0', duration: 0.05 });

      if (clicks <= messages.length) {
        winMsg.textContent = messages[clicks - 1];
        winMsg.style.color = clicks === 3 ? '#ff4d00' : 'var(--accent-primary)';
      }

      if (clicks >= 3) {
        noBtn.textContent = '[ Yes, Open! ]';
        noBtn.style.background = 'var(--accent-primary)';
        noBtn.style.color = '#0b0d10';
        setTimeout(() => {
          window.location.href = '/projects';
        }, 1000);
      }
    });
  }

  // ============================================
  // 15. TOP RETRO SCROLL PROGRESS INDICATOR
  // ============================================
  function initScrollProgress() {
    const progressLine = document.getElementById('scroll-progress-line');
    if (!progressLine) return;

    ScrollTrigger.create({
      start: 'top top',
      end: 'max',
      onUpdate: (self) => {
        progressLine.style.width = `${Math.round(self.progress * 100)}%`;
      },
    });
  }

  // ============================================
  // INITIALIZATION SEQUENCE (Strict Scroll Lock)
  // ============================================
  function initAll() {
    // Keep scroll locked until the entrance animation is 100% finished
    lockScroll();

    if (sessionStorage.getItem('hzb-booted')) {
      // Already booted in this session - begin animations after DOM paint
      setTimeout(startAnimations, 80);
    } else {
      // Wait for preloader:complete event
      window.addEventListener('preloader:complete', startAnimations, { once: true });
    }
  }

  function startAnimations() {
    initHeroAnimations();
    initAboutSection();
    initPixelsStory();
    initDNASection();
    initEmotionSection();
    initBeautySection();
    initHandsSection();
    initWindowsSection();
    initTetrisSection();
    initWorldSection();
    initModeToggle();
    initGreetingScramble();
    initContactTriggers();
    initWindowNoButton();
    initScrollProgress();

    // Skip boot button handler
    const skipBtn = document.getElementById('skip-boot-btn');
    skipBtn?.addEventListener('click', skipBoot);

    // Refresh ScrollTrigger after all animations registered
    ScrollTrigger.refresh();
  }

  initAll();

  // ============================================
  // RESIZE HANDLER & CLEANUP
  // ============================================
  const handleResize = () => ScrollTrigger.refresh();
  window.addEventListener('resize', handleResize);

  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(() => ScrollTrigger.refresh());
  }

  window.addEventListener('pagehide', () => {
    window.removeEventListener('resize', handleResize);
    ScrollTrigger.getAll().forEach((t) => t.kill());
  }, { once: true });
</script>

