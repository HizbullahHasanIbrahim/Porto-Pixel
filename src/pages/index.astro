<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initScrollStorytelling() {
    // 1. Hero animations
    gsap.from('.terminal-badge', {
      opacity: 0,
      y: -20,
      duration: 0.8,
      ease: 'power2.out',
    });

    gsap.from('.hero-title', {
      opacity: 0,
      scale: 0.95,
      duration: 1,
      delay: 0.2,
      ease: 'back.out(1.7)',
    });

    gsap.from('.hero-avatar-box', {
      opacity: 0,
      scale: 0.8,
      duration: 0.8,
      delay: 0.4,
      ease: 'power2.out',
    });

    // 2. Section animations - each section fades in from opposite sides
    const sectionIds = ['hero', 'creator', 'pixels', 'brain', 'windows', 'tetris', 'contact'];
    sectionIds.forEach((id, i) => {
      gsap.from(`#${id}-enter`, {
        opacity: 0,
        x: i % 2 === 0 ? -50 : 50,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: `#${id}`,
          start: 'top 85%',
          end: 'bottom 60%',
          scrub: 1,
        }
      });
    });

    // 3. Cascade Windows ScrollTrigger (stagger reveal)
    const cascadeWindows = gsap.utils.toArray('.cascade-window');
    if (cascadeWindows.length > 0) {
      gsap.from(cascadeWindows, {
        scrollTrigger: {
          trigger: '#windows',
          start: 'top 80%',
          toggleActions: 'play none none none',
        },
        opacity: 0,
        y: 60,
        scale: 0.8,
        stagger: 0.15,
        duration: 0.8,
        ease: 'back.out(1.7)',
      });
    }

    // 4. Creator section triggers
    gsap.from('.rpg-stats', {
      scrollTrigger: {
        trigger: '#creator',
        start: 'top 75%',
      },
      opacity: 0,
      x: -30,
      duration: 0.8,
      ease: 'power2.out',
    });

    // 5. Brain section triggers
    gsap.from('.brain-card.left', {
      scrollTrigger: {
        trigger: '#brain',
        start: 'top 75%',
      },
      opacity: 0,
      x: -40,
      duration: 0.8,
      ease: 'power2.out',
    });

    gsap.from('.brain-card.right', {
      scrollTrigger: {
        trigger: '#brain',
        start: 'top 75%',
      },
      opacity: 0,
      x: 40,
      duration: 0.8,
      ease: 'power2.out',
    });

    // Active dot handling is now owned by SectionNav (scroll-driven, self-contained).

    // Refresh ScrollTrigger once fully loaded to prevent calculation mismatch
    ScrollTrigger.refresh();
  }

  // Pixel Matrix Canvas logic
  function initPixelMatrix() {
    const canvas = document.getElementById('pixel-matrix-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const COLS = 30;
    const ROWS = 12;
    const cellW = canvas.width / COLS;
    const cellH = canvas.height / ROWS;
    const grid: number[][] = Array(ROWS).fill(0).map(() => Array(COLS).fill(0));

    function draw() {
      if (!ctx || !canvas) return;
      ctx.fillStyle = '#0b0d10';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const val = grid[r][c];
          if (val > 0) {
            ctx.fillStyle = val === 2 ? '#38bdf8' : '#00ff66';
            ctx.fillRect(c * cellW + 1, r * cellH + 1, cellW - 2, cellH - 2);
          } else {
            ctx.strokeStyle = 'rgba(0, 255, 102, 0.08)';
            ctx.strokeRect(c * cellW, r * cellH, cellW, cellH);
          }
        }
      }
    }

    function handleInput(e: MouseEvent | TouchEvent) {
      const rect = canvas!.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
      const scaleX = canvas!.width / rect.width;
      const scaleY = canvas!.height / rect.height;
      const x = (clientX - rect.left) * scaleX;
      const y = (clientY - rect.top) * scaleY;

      const col = Math.floor(x / cellW);
      const row = Math.floor(y / cellH);

      if (row >= 0 && row < ROWS && col >= 0 && col < COLS) {
        grid[row][col] = (grid[row][col] + 1) % 3;
        draw();
      }
    }

    canvas.addEventListener('mousemove', (e) => {
      if (e.buttons === 1) handleInput(e);
    });
    canvas.addEventListener('pointerdown', handleInput);
    canvas.addEventListener('touchmove', (e) => {
      e.preventDefault();
      handleInput(e);
    });

    document.getElementById('matrix-clear-btn')?.addEventListener('click', () => {
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          grid[r][c] = 0;
        }
      }
      draw();
    });

    document.getElementById('matrix-rand-btn')?.addEventListener('click', () => {
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          grid[r][c] = Math.random() < 0.25 ? Math.floor(Math.random() * 2) + 1 : 0;
        }
      }
      draw();
    });

    // Initial random pattern
    for (let c = 0; c < COLS; c++) {
      grid[Math.floor(ROWS / 2)][c] = c % 2 === 0 ? 1 : 0;
    }
    draw();
  }

  // Footer contact modal trigger
  document.getElementById('footer-contact-trigger')?.addEventListener('click', () => {
    const dialog = document.getElementById('contact-dialog') as HTMLDialogElement | null;
    dialog?.showModal();
  });

  // Also refresh after fonts load
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(() => {
      ScrollTrigger.refresh();
    });
  }

  // Cleanup on unload to prevent event listener leaks
  window.addEventListener('pagehide', () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
  });
</script>

