<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== 'undefined') {
    (window as any).gsap = gsap;
    (window as any).ScrollTrigger = ScrollTrigger;
  }

  // ============================================
  // SCROLL-LOCK CONTROLLER (Animasi Selesai Dulu)
  // ============================================
  let isScrollLocked = true;
  let isBootComplete = false;
  let heroTimeline: gsap.core.Timeline | null = null;

  function skipBoot() {
    if (isBootComplete) return;
    isBootComplete = true;

    // Kill running hero entrance timeline, then jump to final states
    heroTimeline?.kill();
    heroTimeline = null;

    // Immediately complete the hero timeline and unlock scroll
    unlockScroll();

    // Set all animated elements to their final states instantly
    gsap.set('.terminal-badge', { opacity: 1, y: 0 });
    gsap.set('.hero-title', { opacity: 1, y: 0 });
    gsap.set('.hero-headline', { opacity: 1, y: 0 });
    gsap.set('.hero-subheadline', { opacity: 1, y: 0 });
    gsap.set('.hero-avatar-box', { opacity: 1, scale: 1, rotation: 0 });
    gsap.set('.mode-toggle-group .mode-btn', { opacity: 1, y: 0, scale: 1 });
    gsap.set('.scroll-prompt', { opacity: 1, y: 0 });
    gsap.set('.skip-boot-btn', { opacity: 0, pointerEvents: 'none' });
  }

  function preventDefaultScroll(e: Event) {
    if (isScrollLocked) {
      e.preventDefault();
      // Gentle shake visual feedback if user tries to scroll prematurely
      const lockBadge = document.getElementById('scroll-lock-badge');
      if (lockBadge && !lockBadge.classList.contains('shake')) {
        lockBadge.classList.add('shake');
        setTimeout(() => lockBadge?.classList.remove('shake'), 400);
      }
    }
  }

  function preventScrollKeys(e: KeyboardEvent) {
    if (isScrollLocked && ['Space', 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', 'Escape'].includes(e.code)) {
      e.preventDefault();
      if (e.code === 'Escape') {
        skipBoot();
        return;
      }
      const lockBadge = document.getElementById('scroll-lock-badge');
      if (lockBadge && !lockBadge.classList.contains('shake')) {
        lockBadge.classList.add('shake');
        setTimeout(() => lockBadge?.classList.remove('shake'), 400);
      }
    }
  }

  function lockScroll() {
    isScrollLocked = true;
    document.documentElement.classList.add('scroll-locked');
    document.body.classList.add('scroll-locked');
    window.addEventListener('wheel', preventDefaultScroll, { passive: false });
    window.addEventListener('touchmove', preventDefaultScroll, { passive: false });
    window.addEventListener('keydown', preventScrollKeys, { passive: false });
  }

  function unlockScroll() {
    isScrollLocked = false;
    isBootComplete = true;
    document.documentElement.classList.remove('scroll-locked');
    document.body.classList.remove('scroll-locked');
    window.removeEventListener('wheel', preventDefaultScroll);
    window.removeEventListener('touchmove', preventDefaultScroll);
    window.removeEventListener('keydown', preventScrollKeys);

    // Update prompt badge state to UNLOCKED with neon fanfare
    const lockBadge = document.getElementById('scroll-lock-badge');
    const lockIcon = lockBadge?.querySelector('.badge-icon');
    const badgeStatus = lockBadge?.querySelector('.badge-status');
    const promptArrow = document.querySelector('.prompt-arrow');

    if (lockBadge) {
      lockBadge.classList.remove('locked');
      lockBadge.classList.add('unlocked');
    }
    if (lockIcon) lockIcon.textContent = '⚡';
    if (badgeStatus) badgeStatus.textContent = 'READY // SCROLL UNLOCKED';
    if (promptArrow) promptArrow.classList.add('bouncing');

    // Hide skip boot button
    const skipBtn = document.getElementById('skip-boot-btn');
    if (skipBtn) {
      skipBtn.style.opacity = '0';
      skipBtn.style.pointerEvents = 'none';
    }

    // Click on prompt smoothly navigates to about section
    const promptEl = document.getElementById('hero-scroll-prompt');
    if (promptEl) {
      promptEl.style.cursor = 'pointer';
      promptEl.title = 'Click or scroll down to explore';
      promptEl.addEventListener('click', () => {
        document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });
      }, { once: true });
    }

    // Refresh GSAP ScrollTrigger to ensure all trigger coordinates match active scroll
    ScrollTrigger.refresh();
  }

  // Cyber text unscramble decoding effect
  function cyberDecodeText(element: HTMLElement, finalStr: string, durationMs: number = 700) {
    const chars = '!@#$%^&*<>[]{}/*_+-~=01';
    const totalFrames = Math.max(8, Math.floor(durationMs / 32));
    let frame = 0;
    const interval = setInterval(() => {
      frame++;
      const progress = frame / totalFrames;
      const revealedLength = Math.floor(progress * finalStr.length);
      let scrambled = finalStr.slice(0, revealedLength);
      for (let i = revealedLength; i < finalStr.length; i++) {
        if (finalStr[i] === ' ') {
          scrambled += ' ';
        } else {
          scrambled += chars[Math.floor(Math.random() * chars.length)];
        }
      }
      element.textContent = scrambled;
      if (element.hasAttribute('data-text')) {
        element.setAttribute('data-text', scrambled);
      }
      if (frame >= totalFrames) {
        clearInterval(interval);
        element.textContent = finalStr;
        if (element.hasAttribute('data-text')) {
          element.setAttribute('data-text', finalStr);
        }
      }
    }, 32);
  }

  // ============================================
  // 1. PRELOADER COMPLETION - Start Hero Animations
  // ============================================
  function initHeroAnimations() {
    // Reduced motion: skip timeline, set final states, unlock immediately
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      lockScroll();
      gsap.set('.terminal-badge', { opacity: 1, y: 0 });
      gsap.set('.hero-title', { opacity: 1, y: 0 });
      gsap.set('.hero-headline', { opacity: 1, y: 0 });
      gsap.set('.hero-subheadline', { opacity: 1, y: 0 });
      gsap.set('.hero-avatar-box', { opacity: 1, scale: 1, rotation: 0 });
      gsap.set('.mode-toggle-group .mode-btn', { opacity: 1, y: 0, scale: 1 });
      gsap.set('.scroll-prompt', { opacity: 1, y: 0 });
      const skipBtn = document.getElementById('skip-boot-btn');
      if (skipBtn) {
        skipBtn.style.opacity = '0';
        skipBtn.style.pointerEvents = 'none';
      }
      unlockScroll();
      return;
    }

    // Ensure scroll is locked at the start of hero sequence
    lockScroll();

    // Prepare initial visual states
    gsap.set('.terminal-badge', { opacity: 0, y: -20 });
    gsap.set('.hero-title', { opacity: 0, y: 15 });
    gsap.set('.hero-headline', { opacity: 0, y: 20 });
    gsap.set('.hero-subheadline', { opacity: 0, y: 20 });
    gsap.set('.hero-avatar-box', { opacity: 0, scale: 0.65, rotation: -3 });
    gsap.set('.mode-toggle-group .mode-btn', { opacity: 0, y: 25, scale: 0.9 });
    gsap.set('.scroll-prompt', { opacity: 0, y: 20 });

    const heroTl = gsap.timeline({
      onComplete: () => {
        // Unlock scroll ONLY after the full hero entrance sequence completes!
        unlockScroll();
      },
    });
    heroTimeline = heroTl;

    // 1. Terminal badge drops in & decodes
    heroTl.to('.terminal-badge', {
      opacity: 1,
      y: 0,
      duration: 0.45,
      ease: 'back.out(1.7)',
      onStart: () => {
        const badgeText = document.querySelector<HTMLElement>('.badge-text');
        if (badgeText) cyberDecodeText(badgeText, 'STATUS: SYSTEM ONLINE // PORT 4321', 550);
      },
    }, 0.05);

    // 2. Hero title pops in with cyber unscramble glitch
    heroTl.to('.hero-title', {
      opacity: 1,
      y: 0,
      duration: 0.5,
      ease: 'power2.out',
      onStart: () => {
        const glitchEl = document.getElementById('hero-glitch-name');
        const titleSub = document.getElementById('hero-title-sub');
        if (glitchEl) cyberDecodeText(glitchEl, 'HIZBULLAH', 650);
        if (titleSub) cyberDecodeText(titleSub, 'HASAN IBRAHIM', 650);
      },
    }, 0.3);

    // 3. Headline & subheadline slide up
    heroTl.to('.hero-headline', { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, 0.55)
          .to('.hero-subheadline', { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, 0.7);

    // 4. Avatar box drops with 8-bit spring bounce & power-up aura
    heroTl.to('.hero-avatar-box', {
      opacity: 1,
      scale: 1,
      rotation: 0,
      duration: 0.55,
      ease: 'back.out(2)',
      onStart: () => {
        const currentMode = document.documentElement.getAttribute('data-mode') || 'developer';
        createModeParticles(currentMode);
      },
    }, 0.85);

    // 5. Mode buttons snap in
    heroTl.to('.mode-toggle-group .mode-btn', {
      opacity: 1,
      y: 0,
      scale: 1,
      stagger: 0.1,
      duration: 0.4,
      ease: 'back.out(1.7)',
    }, 1.1);

    // 6. Scroll prompt reveals with locked status badge
    heroTl.to('.scroll-prompt', {
      opacity: 1,
      y: 0,
      duration: 0.4,
      ease: 'power2.out',
    }, 1.35);

    // 7. Small buffer before unlock so user perceives the complete boot sequence
    heroTl.to({}, { duration: 0.2 });

    // Hero scroll parallax scrub (activated once scroll is unlocked)
    ScrollTrigger.create({
      trigger: '#hero',
      start: 'top top',
      end: 'bottom top',
      scrub: 1,
      onUpdate: (self) => {
        const p = self.progress;
        gsap.set('.hero-avatar-box', { y: p * 50, scale: 1 - p * 0.08 });
        gsap.set('.hero-title', { y: -p * 35 });
        gsap.set('.scroll-prompt', { opacity: Math.max(0, 1 - p * 3.5), y: -p * 20 });
      },
    });
  }

  // ============================================
  // 2. ABOUT SECTION - RPG Character Select & Stats
  // ============================================
  function initAboutSection() {
    // Character Spec Definitions
    const specsData: Record<string, {
      title: string;
      classTitle: string;
      quote: string;
      stats: Array<{ label: string; progress: number; fillClass: string }>;
    }> = {
      dev: {
        title: 'SYSTEMS ARCHITECT',
        classTitle: 'Sistem Informasi & Microservices Engineer',
        quote: '"Turning complex business logic into rock-solid 3NF architectures & high-concurrency systems."',
        stats: [
          { label: 'SYSTEMS ANALYSIS & 3NF', progress: 98, fillClass: 'stat-fill' },
          { label: 'DATABASE & ORM ARCH', progress: 95, fillClass: 'stat-fill alt' },
          { label: 'MICROSERVICES & SSR', progress: 90, fillClass: 'stat-fill' },
          { label: 'HACKATHON SPEED-RUN', progress: 98, fillClass: 'stat-fill warn' },
        ],
      },
      creative: {
        title: 'CREATIVE TECHNOLOGIST',
        classTitle: 'Creative Developer & 2D Motion Designer',
        quote: '"Blending math, canvas physics, and 8-bit retro soul to create delightful interactive web experiences."',
        stats: [
          { label: 'HTML5 CANVAS 2D ENGINES', progress: 96, fillClass: 'stat-fill warn' },
          { label: 'GSAP & SCROLL STORYTELLING', progress: 95, fillClass: 'stat-fill alt' },
          { label: 'RETRO-PIXEL SHADER & SVGS', progress: 92, fillClass: 'stat-fill' },
          { label: 'MICRO-INTERACTIONS & CRAFT', progress: 94, fillClass: 'stat-fill alt' },
        ],
      },
    };

    let currentSpec = 'dev';

    function setSpec(specKey: string, syncTheme = true) {
      if (specKey !== 'dev' && specKey !== 'creative') return;
      currentSpec = specKey;
      const data = specsData[specKey];
      if (!data) return;

      // 1. Update Tabs UI
      const tabDev = document.getElementById('tab-spec-dev');
      const tabCreative = document.getElementById('tab-spec-creative');
      if (tabDev && tabCreative) {
        tabDev.classList.toggle('active', specKey === 'dev');
        tabDev.setAttribute('aria-selected', specKey === 'dev' ? 'true' : 'false');
        tabCreative.classList.toggle('active', specKey === 'creative');
        tabCreative.setAttribute('aria-selected', specKey === 'creative' ? 'true' : 'false');
      }

      // 2. Avatar bounce & power-up burst
      const avatarBox = document.getElementById('creator-avatar');
      const avatarDev = document.querySelector<HTMLElement>('#creator-avatar .avatar-dev');
      const avatarCreative = document.querySelector<HTMLElement>('#creator-avatar .avatar-creative');

      if (avatarBox) {
        gsap.killTweensOf(avatarBox);
        gsap.timeline()
          .to(avatarBox, { scale: 0.88, y: -8, duration: 0.1, ease: 'power1.out' })
          .to(avatarBox, { scale: 1.08, y: 3, duration: 0.14, ease: 'back.out(2)' })
          .to(avatarBox, { scale: 1, y: 0, duration: 0.12, ease: 'power2.out' });

        createBurstAt(avatarBox, specKey === 'creative' ? ['#ff4d00', '#7c3aed', '#ffde00'] : ['#00ff66', '#38bdf8', '#ffde00']);
      }

      // 3. Switch avatar visuals
      if (avatarDev && avatarCreative) {
        if (specKey === 'creative') {
          avatarDev.style.display = 'none';
          avatarCreative.style.display = 'block';
        } else {
          avatarDev.style.display = 'block';
          avatarCreative.style.display = 'none';
        }
      }

      // 4. Cyber decode text
      const nameEl = document.getElementById('creator-name');
      const classEl = document.getElementById('creator-class');
      const quoteEl = document.getElementById('creator-quote');
      if (nameEl) cyberDecodeText(nameEl, data.title, 420);
      if (classEl) cyberDecodeText(classEl, data.classTitle, 460);
      if (quoteEl) {
        gsap.to(quoteEl, {
          opacity: 0,
          y: -4,
          duration: 0.15,
          onComplete: () => {
            quoteEl.textContent = data.quote;
            gsap.to(quoteEl, { opacity: 1, y: 0, duration: 0.25 });
          },
        });
      }

      // 5. Update Stat Cards with animated bars & counting values
      const cards = document.querySelectorAll<HTMLElement>('#creator-stats-grid .stat-card');
      cards.forEach((card, index) => {
        const stat = data.stats[index];
        if (!stat) return;

        const label = card.querySelector<HTMLElement>('.stat-label');
        const fill = card.querySelector<HTMLElement>('.stat-fill');
        const valSpan = card.querySelector<HTMLElement>('.stat-value');
        const iconDev = card.querySelector<HTMLElement>('.icon-dev');
        const iconCreative = card.querySelector<HTMLElement>('.icon-creative');

        if (iconDev && iconCreative) {
          iconDev.style.display = specKey === 'dev' ? 'inline-flex' : 'none';
          iconCreative.style.display = specKey === 'creative' ? 'inline-flex' : 'none';
        }

        if (label) label.textContent = stat.label;
        if (fill) {
          fill.className = stat.fillClass;
          fill.dataset.progress = stat.progress.toString();

          gsap.killTweensOf(fill);
          gsap.to(fill, {
            width: `${stat.progress}%`,
            duration: 0.65,
            ease: 'back.out(1.2)',
            onUpdate: () => {
              if (valSpan) {
                const currentWidth = parseFloat(fill.style.width || '0');
                valSpan.textContent = `${Math.min(stat.progress, Math.round(currentWidth))}/100`;
              }
            },
            onComplete: () => {
              if (valSpan) valSpan.textContent = `${stat.progress}/100`;
            },
          });
        }
      });

      // 6. Swap perks
      const perksDev = document.querySelector<HTMLElement>('.perks-dev');
      const perksCreative = document.querySelector<HTMLElement>('.perks-creative');
      if (perksDev && perksCreative) {
        if (specKey === 'creative') {
          perksDev.style.display = 'none';
          perksCreative.style.display = 'flex';
          gsap.fromTo(perksCreative, { opacity: 0, y: 5 }, { opacity: 1, y: 0, duration: 0.3 });
        } else {
          perksDev.style.display = 'flex';
          perksCreative.style.display = 'none';
          gsap.fromTo(perksDev, { opacity: 0, y: 5 }, { opacity: 1, y: 0, duration: 0.3 });
        }
      }

      // 7. Synchronize with global theme mode
      if (syncTheme) {
        const targetTheme = specKey === 'creative' ? 'creative' : 'developer';
        const currentTheme = document.documentElement.getAttribute('data-mode') || 'developer';
        if (targetTheme !== currentTheme) {
          document.documentElement.setAttribute('data-mode', targetTheme);
          localStorage.setItem('hzb-theme-mode', targetTheme);
          window.dispatchEvent(new CustomEvent('hzb-theme-change', { detail: { mode: targetTheme } }));
        }
      }
    }

    function createBurstAt(container: HTMLElement, colors: string[]) {
      for (let i = 0; i < 12; i++) {
        const p = document.createElement('div');
        const color = colors[Math.floor(Math.random() * colors.length)];
        const angle = (Math.PI * 2 * i) / 12;
        const dist = 45 + Math.random() * 35;
        p.style.cssText = `
          position: absolute; width: 6px; height: 6px; background: ${color};
          left: 50%; top: 50%; transform: translate(-50%, -50%);
          pointer-events: none; z-index: 25; box-shadow: 1px 1px 0px #0b0d10;
        `;
        container.style.position = 'relative';
        container.appendChild(p);
        gsap.to(p, {
          x: Math.cos(angle) * dist,
          y: Math.sin(angle) * dist,
          opacity: 0,
          scale: 0,
          duration: 0.5 + Math.random() * 0.25,
          ease: 'power2.out',
          onComplete: () => p.remove(),
        });
      }
    }

    // Attach click handlers
    document.getElementById('tab-spec-dev')?.addEventListener('click', () => setSpec('dev'));
    document.getElementById('tab-spec-creative')?.addEventListener('click', () => setSpec('creative'));
    document.getElementById('spec-nav-prev')?.addEventListener('click', () => {
      setSpec(currentSpec === 'dev' ? 'creative' : 'dev');
    });
    document.getElementById('spec-nav-next')?.addEventListener('click', () => {
      setSpec(currentSpec === 'dev' ? 'creative' : 'dev');
    });

    // Listen to external theme changes (Header or Hero toggle)
    window.addEventListener('hzb-theme-change', ((e: Event) => {
      const customEvent = e as CustomEvent<{ mode?: string }>;
      const mode = customEvent.detail?.mode;
      if (mode && (mode === 'developer' || mode === 'creative')) {
        const specKey = mode === 'creative' ? 'creative' : 'dev';
        if (specKey !== currentSpec) {
          setSpec(specKey, false);
        }
      }
    }) as EventListener);

    // Initial check from active data-mode
    const initialMode = document.documentElement.getAttribute('data-mode') || 'developer';
    if (initialMode === 'creative') {
      setSpec('creative', false);
    }

    const mm = gsap.matchMedia();

    mm.add('(min-width: 769px)', () => {
      // Pin the about section for stat bar scrub animation with real-time numeric counter
      ScrollTrigger.create({
        trigger: '#about',
        start: 'top 80%',
        end: 'bottom 60%',
        scrub: 1,
        onUpdate: (self) => {
          const progress = self.progress;
          document.querySelectorAll<HTMLElement>('.stat-fill').forEach((fill) => {
            const target = parseInt(fill.dataset.progress || '0', 10);
            const current = Math.round(target * progress);
            fill.style.width = `${current}%`;
            const card = fill.closest('.stat-card');
            const valSpan = card?.querySelector<HTMLElement>('.stat-value');
            if (valSpan) {
              valSpan.textContent = `${current}/100`;
            }
          });
        },
      });

      // Window entrance float elevation
      gsap.from('.creator-profile-window', {
        scrollTrigger: { trigger: '#about', start: 'top 90%', end: 'top 50%', scrub: 1 },
        y: 30,
        opacity: 0.85,
      });
    });

    mm.add('(max-width: 768px)', () => {
      // Mobile: stat fill animation with counting feedback
      gsap.from('.stat-fill', {
        scrollTrigger: { trigger: '#about', start: 'top 80%' },
        width: '0%',
        duration: 1,
        stagger: 0.1,
        ease: 'power2.out',
        onUpdate: function() {
          document.querySelectorAll<HTMLElement>('.stat-fill').forEach((fill) => {
            const target = parseInt(fill.dataset.progress || '0', 10);
            const widthPct = parseFloat(fill.style.width || '0');
            const current = Math.round((widthPct / 100) * target);
            const card = fill.closest('.stat-card');
            const valSpan = card?.querySelector<HTMLElement>('.stat-value');
            if (valSpan && !isNaN(current)) {
              valSpan.textContent = `${Math.min(target, Math.max(0, current))}/100`;
            }
          });
        },
      });
    });
  }

  // ============================================
  // DOM BUILDERS (Unified Mobile & Desktop)
  // ============================================
  function buildConstellationDOM() {
    const constellationCanvas = document.getElementById('constellation-canvas');
    if (!constellationCanvas || constellationCanvas.dataset.initialized === 'true') return;
    constellationCanvas.dataset.initialized = 'true';
    constellationCanvas.innerHTML = '';

    // Cyber HUD Header
    const hud = document.createElement('div');
    hud.className = 'constellation-hud';
    hud.innerHTML = `
      <span>[ NET: SYNAPSE-64 ]</span>
      <span class="hud-coords">STATUS: ACTIVE</span>
      <span>NODES: 32</span>
    `;
    constellationCanvas.appendChild(hud);

    // SVG container for constellation lines
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', 'constellation-svg-lines');
    svg.setAttribute('viewBox', '0 0 100 100');
    svg.setAttribute('preserveAspectRatio', 'none');
    constellationCanvas.appendChild(svg);

    // Generate coordinates for dots
    const coords: { x: number; y: number }[] = [];
    const numDots = 32;
    for (let i = 0; i < numDots; i++) {
      const x = 8 + Math.random() * 84;
      const y = 16 + Math.random() * 72;
      coords.push({ x, y });

      const dot = document.createElement('div');
      dot.className = 'constellation-dot';
      dot.style.cssText = `
        position: absolute;
        width: 6px; height: 6px;
        background: var(--accent-primary);
        left: ${x}%;
        top: ${y}%;
        transform: translate(-50%, -50%);
        box-shadow: 0 0 6px var(--accent-primary);
        z-index: 2;
      `;
      constellationCanvas.appendChild(dot);
    }

    // Connect nearby dots with SVG lines
    for (let i = 0; i < coords.length; i++) {
      for (let j = i + 1; j < coords.length; j++) {
        const dx = coords[i].x - coords[j].x;
        const dy = coords[i].y - coords[j].y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 22) {
          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          line.setAttribute('x1', String(coords[i].x));
          line.setAttribute('y1', String(coords[i].y));
          line.setAttribute('x2', String(coords[j].x));
          line.setAttribute('y2', String(coords[j].y));
          line.setAttribute('stroke', 'var(--accent-secondary)');
          line.setAttribute('stroke-width', '0.6');
          line.setAttribute('stroke-opacity', '0.6');
          line.setAttribute('class', 'constellation-line');
          svg.appendChild(line);
        }
      }
    }
  }

