      .fromTo('.eye-hud-bracket.bottom-right', { x: 15, y: 15, opacity: 0 }, { x: 0, y: 0, opacity: 1, duration: 0.3 }, 0)
      .to('.eye-target-badge', { opacity: 1, duration: 0.25 }, 0.2);

