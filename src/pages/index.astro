        <RetroWindow 
          title="TECH_STACK.EXE" 
          type="exe" 
          class="cascade-window window-layer-1"
          id="cascade-win-1"
        >
          <div class="window-inner-content">
            <h4 class="win-heading">CORE TECH STACK</h4>
            <p class="win-p">Arsitektur modern dengan sentuhan estetika komputasi klasik:</p>
            <div class="tech-grid-compact">
              <span class="tag-pill">Astro SSG</span>
              <span class="tag-pill">GSAP ScrollTrigger</span>
              <span class="tag-pill">TypeScript</span>
              <span class="tag-pill">Canvas 2D</span>
              <span class="tag-pill">PostgreSQL</span>
              <span class="tag-pill">Redis</span>
              <span class="tag-pill">Docker</span>
              <span class="tag-pill">Tailwind CSS</span>
            </div>
          </div>
        </RetroWindow>

        <!-- Window 2: EXPERIENCE.SYS -->
        <RetroWindow 
          title="EXPERIENCE.SYS" 
          type="sys" 
          class="cascade-window window-layer-2"
          id="cascade-win-2"
        >
          <div class="window-inner-content">
            <h4 class="win-heading">PRODUCTION EXPERIENCE</h4>
            <ul class="bullet-retro">
              <li><strong>Lead Developer @ Startup E-Commerce:</strong> Performa load &lt; 0.8s dengan Astro + Redis caching.</li>
              <li><strong>Database Architect @ SIAKAD Pixel:</strong> Migrasi zero-downtime untuk 10.000+ data mahasiswa aktif.</li>
              <li><strong>Interactive Game Designer:</strong> Merancang Phaser &amp; Canvas games dengan puluhan ribu total plays.</li>
            </ul>
          </div>
        </RetroWindow>

        <!-- Window 3: ACHIEVEMENTS.ALERT -->
        <RetroWindow 
          title="ACHIEVEMENTS.ALERT" 
          type="alert" 
          class="cascade-window window-layer-3"
          id="cascade-win-3"
        >
          <div class="window-inner-content">
            <h4 class="win-heading">COMPETITIONS &amp; RECOGNITION</h4>
            <div class="alert-box">
              <span class="alert-icon">🏆</span>
              <div class="alert-text">
                <strong>JUARA 1 - CODEQUEST 2024 NATIONAL HACKATHON</strong>
                <p>Kategori Best Technical Implementation dengan game realtime platformer multipemain.</p>
              </div>
            </div>
          </div>
        </RetroWindow>

        <!-- Window 4: PHILOSOPHY.DLL -->
        <RetroWindow 
          title="PHILOSOPHY.DLL" 
          type="exe" 
          class="cascade-window window-layer-4"
          id="cascade-win-4"
        >
          <div class="window-inner-content">
            <h4 class="win-heading">DESIGN MANIFESTO</h4>
            <p class="manifesto-quote">
              "Perangkat lunak terbaik menggabungkan ketahanan sistemik yang tak tergoyahkan dengan kehangatan interaktivitas yang menyenangkan pengguna."
            </p>
          </div>
        </RetroWindow>
      </div>
    </div>
  </section>

  <!-- SECTION 6: TETRIS CTA -->
  <section id="tetris" class="story-section tetris-section">
    <div class="section-container" id="tetris-enter">
      <RetroWindow title="LEVEL_COMPLETE.EXE" type="exe" class="tetris-window">
        <div class="tetris-content">
          <div class="tetris-blocks">
            <div class="t-block t1"></div>
            <div class="t-block t2"></div>
            <div class="t-block t3"></div>
            <div class="t-block t4"></div>
          </div>
          <h2 class="tetris-title">STAGE CLEARED! READY FOR THE NEXT LEVEL?</h2>
          <p class="tetris-sub">Uji keahlianmu di Claw Machine atau lari tanpa henti di Pixel Runner:</p>
          
          <div class="tetris-action-row">
            <a href="/projects" class="pixel-btn primary large">
              <span>EXPLORE ALL PROJECTS</span>
            </a>
            <a href="/game" class="pixel-btn secondary large">
              <span>PLAY PIXEL RUNNER</span>
            </a>
