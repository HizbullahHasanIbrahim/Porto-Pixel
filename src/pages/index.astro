  </section>

  <!-- SECTION 7: WORLD FOOTER / CONTACT -->
  <footer id="contact" class="story-section world-footer">
    <div class="footer-horizon" id="contact-enter">
      <!-- 8-Bit Skyline SVG -->
      <svg viewBox="0 0 800 60" preserveAspectRatio="none" class="skyline-svg" shape-rendering="crispEdges">
