  function buildDNADOM() {
    const dnaContainer = document.getElementById('dna-strand');
    if (!dnaContainer || dnaContainer.dataset.initialized === 'true') return;
    dnaContainer.dataset.initialized = 'true';
    dnaContainer.innerHTML = `
      <div class="dna-strand-svg" style="height: 100%; width: 100%; display: flex; align-items: center; justify-content: center;">
        <svg viewBox="0 0 100 600" shape-rendering="crispEdges" class="dna-svg" aria-hidden="true" style="height: 100%; width: 100px;">
          <!-- Backbone left -->
          <line x1="35" y1="0" x2="35" y2="600" stroke="var(--accent-primary)" stroke-width="3" />
          <!-- Backbone right -->
          <line x1="65" y1="0" x2="65" y2="600" stroke="var(--accent-secondary)" stroke-width="3" />
          <!-- Base pairs -->
          <g class="dna-pairs"></g>
        </svg>
      </div>
    `;

    const pairsGroup = dnaContainer.querySelector('.dna-pairs');
    if (!pairsGroup) return;
    for (let i = 0; i < 30; i++) {
      const y = i * 20;
      const pair = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      pair.setAttribute('class', 'dna-pair');
      pair.innerHTML = `
        <line x1="35" y1="${y}" x2="65" y2="${y}" stroke="var(--text-muted)" stroke-width="2" />
        <rect x="33" y="${y - 4}" width="4" height="8" fill="var(--accent-primary)" />
        <rect x="63" y="${y - 4}" width="4" height="8" fill="var(--accent-secondary)" />
      `;
      pairsGroup.appendChild(pair);
    }
  }

  // ============================================
  // 3. PIXELS → IDEAS → BRAIN PINNED SCROLL STORY
  // ============================================
  function initPixelsStory() {
    buildConstellationDOM();
    buildBrainDOM();

    const mm = gsap.matchMedia();

    mm.add('(min-width: 769px)', () => {
      const dots = document.querySelectorAll<HTMLElement>('.constellation-dot');
      gsap.set(dots, { opacity: 0, scale: 0 });

      const lines = document.querySelectorAll<SVGLineElement>('.constellation-line');
      gsap.set(lines, { opacity: 0 });

      const brainParts = document.querySelectorAll<SVGElement>('.brain-part');
      gsap.set(brainParts, { opacity: 0, scale: 0.5 });

      const sparks = document.querySelectorAll<HTMLElement>('.spark');
      gsap.set(sparks, { opacity: 0, scale: 0 });

      // Master Timeline for Pixels → Ideas → Brain (Compressed to +=180% to eliminate scroll fatigue)
      const tl = gsap.timeline({
        scrollTrigger: {
          id: 'pixels-story-pin',
          trigger: '#pixels',
          start: 'top top',
          end: '+=180%',
          pin: '#pixels-pin-wrapper',
          pinSpacing: true,
          scrub: 1,
          anticipatePin: 1,
          onUpdate: (self) => {
            let phase = 'pixels';
            if (self.progress >= 0.66) phase = 'brain-section';
            else if (self.progress >= 0.33) phase = 'ideas';
            if ((window as any).__hzbStoryPhase !== phase) {
              (window as any).__hzbStoryPhase = phase;
              window.dispatchEvent(new CustomEvent('hzb-phase-change', { detail: { phase } }));
            }
          },
        },
      });

      // Phase A: Single Pixel + Sparks (0.0 to 1.0s)
      tl.to('#single-pixel', { scale: 1.8, boxShadow: '0 0 30px var(--accent-primary)', duration: 0.35 }, 0.1)
        .to('.spark.s-tl', { x: -28, y: -28, opacity: 1, scale: 1.2, duration: 0.3 }, 0.15)
        .to('.spark.s-tr', { x: 28, y: -28, opacity: 1, scale: 1.2, duration: 0.3 }, 0.15)
        .to('.spark.s-bl', { x: -28, y: 28, opacity: 1, scale: 1.2, duration: 0.3 }, 0.15)
        .to('.spark.s-br', { x: 28, y: 28, opacity: 1, scale: 1.2, duration: 0.3 }, 0.15)
        .to(sparks, { opacity: 0, scale: 0, duration: 0.25 }, 0.45)
        .to('#single-pixel', { scale: 1, boxShadow: '0 0 0 var(--accent-primary)', duration: 0.35 }, 0.45)
        .to('.phase-a', { opacity: 0, duration: 0.3 }, 0.8);

      // Phase B: Constellation Grid & Network Synapses (1.0 to 2.0s)
      tl.to('.phase-b', { opacity: 1, duration: 0.3 }, 1.0)
        .to(dots, {
          opacity: 1,
          scale: 1,
          duration: 0.4,
          stagger: {
            amount: 0.35,
            from: 'random',
          },
        }, 1.1)
        .to(lines, {
          opacity: 0.7,
          duration: 0.35,
          stagger: {
            amount: 0.25,
            from: 'start',
          },
        }, 1.3)
        .to('.constellation-dot', {
          boxShadow: '0 0 10px var(--accent-primary)',
          duration: 0.25,
        }, 1.5)
        .to('.phase-b', { opacity: 0, duration: 0.3 }, 1.8);

      // Phase C: Pixel Brain Assembly + Hologram Scan (2.0 to 3.0s)
      tl.to('.phase-c', { opacity: 1, duration: 0.3 }, 2.0)
        .to(brainParts, {
          opacity: 1,
          scale: 1,
          ease: 'back.out(1.7)',
          duration: 0.45,
          stagger: 0.12,
        }, 2.1)
        .fromTo('#brain-scanline', { top: '0%', opacity: 1 }, { top: '100%', opacity: 0.3, duration: 0.55 }, 2.3)
        .to('.pixel-brain-svg', { scale: 1.06, duration: 0.25 }, 2.65);
    });

    mm.add('(max-width: 768px)', () => {
      const dots = document.querySelectorAll<HTMLElement>('.constellation-dot');
      gsap.set(dots, { opacity: 0.85, scale: 1 });

      const lines = document.querySelectorAll<SVGLineElement>('.constellation-line');
      gsap.set(lines, { opacity: 0.5 });

      const brainParts = document.querySelectorAll<SVGElement>('.brain-part');
      gsap.set(brainParts, { opacity: 1, scale: 1 });

      gsap.from('.phase-a', { scrollTrigger: { trigger: '#pixels', start: 'top 85%' }, opacity: 0, y: 25, duration: 0.8 });
      gsap.from('.phase-b', { scrollTrigger: { trigger: '#ideas', start: 'top 85%' }, opacity: 0, y: 25, duration: 0.8 });
      gsap.from('.phase-c', { scrollTrigger: { trigger: '#brain-section', start: 'top 85%' }, opacity: 0, y: 25, duration: 0.8 });
    });
  }

  // ============================================
  // 4. DNA DOUBLE HELIX (PINNED)
  // ============================================
  function initDNASection() {
    buildDNADOM();

    const mm = gsap.matchMedia();

    mm.add('(min-width: 769px)', () => {
      const pairs = document.querySelectorAll<SVGElement>('.dna-pair');
      gsap.set(pairs, { opacity: 0, transformOrigin: '50% 50%', rotation: 0, scale: 0 });

      // Master Timeline for DNA (Compressed to +=100%)
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#dna',
          start: 'top top',
          end: '+=100%',
          pin: '#dna-pin-wrapper',
          pinSpacing: true,
          scrub: 1,
          anticipatePin: 1,
          onUpdate: (self) => {
            const p = self.progress;
            document.querySelector('.hl-1')?.classList.toggle('active', p >= 0.2);
            document.querySelector('.hl-2')?.classList.toggle('active', p >= 0.4);
            document.querySelector('.hl-3')?.classList.toggle('active', p >= 0.6);
            document.querySelector('.hl-4')?.classList.toggle('active', p >= 0.8);
          },
        },
      });

      tl.from('.dna-text', { opacity: 0, y: 30, duration: 0.4 }, 0);
      tl.to(pairs, {
        opacity: 1,
        scale: 1,
        rotation: 180,
        transformOrigin: '50% 50%',
        ease: 'power2.out',
        duration: 0.4,
        stagger: {
          amount: 0.65,
          from: 'start',
