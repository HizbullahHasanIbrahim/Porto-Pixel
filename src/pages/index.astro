          <div class="footer-social">
            <a href="https://github.com/hzb" class="pixel-btn" title="GitHub" target="_blank">
              <PixelIcons name="github" size={14} />
              <span>GitHub</span>
            </a>
            <a href="https://linkedin.com/in/hzb" class="pixel-btn" title="LinkedIn" target="_blank">
              <PixelIcons name="linkedin" size={14} />
              <span>LinkedIn</span>
            </a>
            <a href="https://twitter.com/hzb_dev" class="pixel-btn" title="Twitter" target="_blank">
